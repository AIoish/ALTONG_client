<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 앱의 모델 파일(수 GB)을 이 도구의 출력 폴더로 복사하지 않는다. 모델은 저장소 models/ 에서 직접 읽는다. -->
    <_GetChildProjectCopyToOutputDirectoryItems>false</_GetChildProjectCopyToOutputDirectoryItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- 네이티브 llama.dll은 직접 참조해야 출력 폴더로 복사된다. 버전은 앱(Altong.Client.csproj)과 같게 유지한다. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- GPU 실험(gpu 옵션)용. 앱에는 아직 넣지 않았다. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <ProjectReference Include="..\..\src\Altong.Client\Altong.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
