<Window x:Class="Altong.MockGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧪 ContextPass 모의 알림 생성기"
        Height="680" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- 공통 텍스트 스타일 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 입력 필드 스타일 -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
        </Style>

        <!-- 콤보박스 스타일 -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 프리셋 버튼 스타일 -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- 전송 버튼 스타일 -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 지연 전송 버튼 스타일 -->
        <Style x:Key="DelayButtonStyle" TargetType="Button" BasedOn="{StaticResource SendButtonStyle}">
            <Setter Property="Background" Value="#FAB387"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <TextBlock Grid.Row="0"
                   Text="🧪 ContextPass 모의 알림 생성기"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#CDD6F4"
                   Margin="0,0,0,16"/>

        <!-- 알림 내용 입력 섹션 -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="📱 알림 내용" FontSize="14" FontWeight="SemiBold"
                           Foreground="#A6ADC8" Margin="0,0,0,12"/>

                <TextBlock Text="앱" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="AppNameComboBox" Style="{StaticResource ComboStyle}"
                          IsEditable="True" Margin="0,0,0,8">
                    <ComboBoxItem Content="KakaoTalk"/>
                    <ComboBoxItem Content="Slack"/>
                    <ComboBoxItem Content="Discord"/>
                    <ComboBoxItem Content="GitHub"/>
                    <ComboBoxItem Content="Chrome"/>
                    <ComboBoxItem Content="Microsoft Teams"/>
                    <ComboBoxItem Content="Line"/>
                </ComboBox>

                <TextBlock Text="발신자" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="SenderTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,8"/>

                <TextBlock Text="제목" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TitleTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,8"/>

                <TextBlock Text="본문" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="BodyTextBox" Style="{StaticResource InputStyle}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <!-- 프리셋 버튼 섹션 -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="📋 프리셋 (클릭 시 위 필드 자동 채움)"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#A6ADC8" Margin="0,0,0,10"/>
                <WrapPanel x:Name="PresetPanel"/>
            </StackPanel>
        </Border>

        <!-- 전송 버튼 영역 -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="SendButton"
                    Style="{StaticResource SendButtonStyle}"
                    Content="📤 즉시 전송"
                    Click="SendNotification_Click"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1" x:Name="DelaySendButton"
                    Style="{StaticResource DelayButtonStyle}"
                    Content="⏱️ 3초 뒤 전송 (창 전환용)"
                    Click="DelaySendNotification_Click"
                    Margin="6,0,0,0"/>
        </Grid>

        <!-- 상태 메시지 -->
        <TextBlock Grid.Row="4" x:Name="StatusText"
                   FontSize="12" Foreground="#A6E3A1"
                   Margin="0,0,0,8"
                   Visibility="Collapsed"/>

        <!-- 전송 이력 섹션 -->
        <Border Grid.Row="5" Background="#181825" CornerRadius="8" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="📜 전송 이력"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#A6ADC8" Margin="0,0,0,10"/>
                <ListView x:Name="HistoryListView"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#CDD6F4"
                          FontSize="12">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="#BAC2DE"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
