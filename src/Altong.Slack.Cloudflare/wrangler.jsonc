{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "altong-slack",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "observability": { "enabled": false },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "SlackRelay" },
      { "name": "INBOX", "class_name": "SlackInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SlackRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["SlackInbox"] }
  ],
  "vars": {
    "SLACK_APP_ID": "A0CK8B7QPSL",
    "SLACK_CLIENT_ID": "12062444213687.12654381839904",
    "PUBLIC_URL": "https://altong-slack.commonworks.workers.dev",
    "TOKEN_ENCRYPTION_KEY_VERSION": "1",
    "RETENTION_HOURS": "24",
    "ALLOWED_TEAMS": ""
  }
}
