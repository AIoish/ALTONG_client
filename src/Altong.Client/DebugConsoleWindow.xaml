<Window x:Class="Altong.Client.DebugConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong - 디버그 콘솔 (작업 맥락 모니터)"
        Height="460" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 요약 카드 -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="ProcessText" FontSize="16" FontWeight="Bold" Foreground="#4EC9B0" Text="🎯 활성 프로세스: 대기 중..." />
                    <TextBlock x:Name="DurationText" HorizontalAlignment="Right" FontSize="13" Foreground="#CE9178" Text="⏱️ 0초 지속" />
                </DockPanel>
                <TextBlock x:Name="TitleText" Margin="0,6,0,0" FontSize="12" Foreground="#DCDCDC" TextTrimming="CharacterEllipsis" Text="📝 창 제목: -" />
                <TextBlock x:Name="CombiText" Margin="0,4,0,0" FontSize="12" Foreground="#9CDCFE" Text="👥 콤비 앱 큐: [없음]" />
            </StackPanel>
        </Border>

        <!-- 하단 실시간 로그 영역 -->
        <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="실시간 이벤트 로그" Foreground="#858585" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="로그 비우기" HorizontalAlignment="Right" Padding="8,2" Background="#2D2D30" Foreground="#CCCCCC" BorderBrush="#3E3E42" Click="ClearLogsButton_Click"/>
            </DockPanel>
            <TextBox x:Name="LogTextBox"
                     Background="#141414"
                     Foreground="#D4D4D4"
                     BorderBrush="#3E3E42"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="12"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Padding="8"/>
        </DockPanel>
    </Grid>
</Window>
