<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Altong.Client.Services">
    <Color x:Key="BlackCanvasColor">#1E1A17</Color>
    <Color x:Key="BlackPaperColor">#17130F</Color>
    <Color x:Key="BlackSurfaceColor">#322D29</Color>
    <Color x:Key="BlackRaisedColor">#3B3631</Color>
    <Color x:Key="BlackInputColor">#191512</Color>
    <Color x:Key="BlackRuleColor">#4A433C</Color>
    <Color x:Key="BlackControlRuleColor">#8E8478</Color>
    <Color x:Key="BlackTextColor">#F7F1E8</Color>
    <Color x:Key="BlackMutedColor">#C9BFB2</Color>
    <Color x:Key="BlackSoftColor">#E4DACD</Color>
    <Color x:Key="BlackActionColor">#E9C995</Color>
    <Color x:Key="BlackActionTextColor">#241B10</Color>
    <Color x:Key="BlackFocusColor">#F5DDB6</Color>
    <Color x:Key="BlackAccentTextColor">#E9C995</Color>
    <Color x:Key="BlackSelectionColor">#3A3025</Color>
    <Color x:Key="BlackSelectionRuleColor">#9C8462</Color>
    <Color x:Key="BlackSuccessColor">#B9D6C2</Color>
    <Color x:Key="BlackSuccessSurfaceColor">#26332B</Color>
    <Color x:Key="BlackSuccessRuleColor">#7FA18C</Color>
    <Color x:Key="BlackSuccessMutedColor">#AFC4B6</Color>
    <Color x:Key="BlackErrorColor">#EBB0A6</Color>
    <Color x:Key="BlackShadowColor">#000000</Color>
    <SolidColorBrush x:Key="BlackCanvas" Color="{StaticResource BlackCanvasColor}" />
    <SolidColorBrush x:Key="BlackPaper" Color="{StaticResource BlackPaperColor}" />
    <SolidColorBrush x:Key="BlackSurface" Color="{StaticResource BlackSurfaceColor}" />
    <SolidColorBrush x:Key="BlackRaised" Color="{StaticResource BlackRaisedColor}" />
    <SolidColorBrush x:Key="BlackInput" Color="{StaticResource BlackInputColor}" />
    <SolidColorBrush x:Key="BlackRule" Color="{StaticResource BlackRuleColor}" />
    <SolidColorBrush x:Key="BlackControlRule" Color="{StaticResource BlackControlRuleColor}" />
    <SolidColorBrush x:Key="BlackText" Color="{StaticResource BlackTextColor}" />
    <SolidColorBrush x:Key="BlackMuted" Color="{StaticResource BlackMutedColor}" />
    <SolidColorBrush x:Key="BlackSoft" Color="{StaticResource BlackSoftColor}" />
    <SolidColorBrush x:Key="BlackAction" Color="{StaticResource BlackActionColor}" />
    <SolidColorBrush x:Key="BlackActionText" Color="{StaticResource BlackActionTextColor}" />
    <SolidColorBrush x:Key="BlackFocus" Color="{StaticResource BlackFocusColor}" />
    <SolidColorBrush x:Key="BlackAccentText" Color="{StaticResource BlackAccentTextColor}" />
    <SolidColorBrush x:Key="BlackSelection" Color="{StaticResource BlackSelectionColor}" />
    <SolidColorBrush x:Key="BlackSelectionRule" Color="{StaticResource BlackSelectionRuleColor}" />
    <SolidColorBrush x:Key="BlackSuccess" Color="{StaticResource BlackSuccessColor}" />
    <SolidColorBrush x:Key="BlackSuccessSurface" Color="{StaticResource BlackSuccessSurfaceColor}" />
    <SolidColorBrush x:Key="BlackSuccessRule" Color="{StaticResource BlackSuccessRuleColor}" />
    <SolidColorBrush x:Key="BlackSuccessMuted" Color="{StaticResource BlackSuccessMutedColor}" />
    <SolidColorBrush x:Key="BlackError" Color="{StaticResource BlackErrorColor}" />
    <SolidColorBrush x:Key="BlackShadow" Color="{StaticResource BlackShadowColor}" />
    <!-- 흑연 유리(E): 창은 번진 빛 배경 위 반투명 흑연, 카드는 그 위의 옅은 유리 판. 떠 있는 창·팝업은 불투명에 가깝게. -->
    <Color x:Key="GlassBackdropColor">#17130F</Color>
    <Color x:Key="GlassAmberGlowColor">#5A3E24</Color>
    <Color x:Key="GlassSlateGlowColor">#2C3B45</Color>
    <Color x:Key="GlassEmberGlowColor">#4A3426</Color>
    <SolidColorBrush x:Key="GlassBackdrop" Color="{StaticResource GlassBackdropColor}" />
    <SolidColorBrush x:Key="GlassWindow" Color="#85262220" />
    <SolidColorBrush x:Key="GlassFloating" Color="#F2292420" />
    <SolidColorBrush x:Key="GlassPane" Color="#0FFFF0DC" />
    <SolidColorBrush x:Key="GlassPaneHover" Color="#1AFFF0DC" />
    <SolidColorBrush x:Key="GlassPaneRule" Color="#1FFFF0DC" />
    <SolidColorBrush x:Key="GlassDivider" Color="#14FFF0DC" />
    <SolidColorBrush x:Key="NavSelected" Color="#1AFFF0DC" />
    <SolidColorBrush x:Key="NavSelectedRule" Color="#29FFF0DC" />
    <SolidColorBrush x:Key="AmberTrack" Color="#0FFFF0DC" />
    <SolidColorBrush x:Key="AmberSoft" Color="#29E9C995" />
    <!-- 유리 판의 테두리: 윗변이 더 밝아 빛이 맺힌 것처럼 보인다. -->
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFF0DC" Offset="0" />
        <GradientStop Color="#1AFFF0DC" Offset="0.18" />
        <GradientStop Color="#14FFF0DC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassWindowRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFF0DC" Offset="0" />
        <GradientStop Color="#1FFFF0DC" Offset="0.06" />
        <GradientStop Color="#1AFFF0DC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TimelineHour" Color="#A99F92" />
    <SolidColorBrush x:Key="GlassInput" Color="#730E0B09" />
    <SolidColorBrush x:Key="GlassInputRule" Color="#29FFF0DC" />
    <!-- ⋯ 메뉴: 유리 위에 뜨는 불투명 흑연 판 -->
    <Style x:Key="BlackMenu" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="FontSize" Value="13" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="{StaticResource BlackRaised}" BorderBrush="{StaticResource BlackRule}" BorderThickness="1" CornerRadius="14" Padding="6" MinWidth="180">
                <ItemsPresenter />
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BlackMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="12,8">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackSelection}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Thickness x:Key="SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Style x:Key="QuietScrollViewer" TargetType="ScrollViewer">
        <Setter Property="services:ScrollWheelBehavior.IsEnabled" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource QuietScrollViewer}" />

    <Style x:Key="BlackDisclosureToggle" TargetType="ToggleButton">
        <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource BlackText}" />
        <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="HeaderSurface" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" CornerRadius="4" Padding="2,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <Path x:Name="Chevron" Grid.Column="1" Data="M 2,4 L 6,8 L 10,4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                          Width="12" Height="12" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" services:MotionBehavior.RotateOnToggle="True" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource BlackSurface}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderSurface" Property="Opacity" Value=".5" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BlackExpander" TargetType="Expander">
        <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource BlackText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="DisclosureHeader" Style="{StaticResource BlackDisclosureToggle}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="0,4,0,10" TextElement.FontWeight="Normal" services:MotionBehavior.FadeOnReveal="True" />
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
