<Window x:Class="Altong.Client.AutoDndSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong 집중 제안"
        Width="384" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None"
        UseLayoutRounding="True">
    <!--
        집중 모드가 꺼져 있을 때 화면 상단 가운데에 내려오는 집중 제안 카드.
        노치 안내 말풍선(ReminderCard)과 같은 색을 쓴다. 클릭해도 작업 중인 창의 포커스를 가져오지 않는다.
        자동 닫힘 시간은 상태 머신이 정하고, 아래 막대는 남은 시간을 보여 주기만 한다.
    -->
    <Window.Resources>
        <Style x:Key="SuggestionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#3A4658" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DDE2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF0F4F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE6EEEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimarySuggestionButton" TargetType="Button" BasedOn="{StaticResource SuggestionButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#168C82" />
            <Setter Property="BorderBrush" Value="#168C82" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#127A71" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0F6A62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12,0,12,18" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideTransform" Y="-16" /></Grid.RenderTransform>
        <Border x:Name="Card" Background="#F7FFFFFF" BorderBrush="#CFE4E0" BorderThickness="1" CornerRadius="18"
                AutomationProperties.Name="집중 모드 제안">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity=".24" ShadowDepth="4" Color="#40536A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="18,14,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 노치 렌즈를 닮은 청록 표시등 -->
                    <Ellipse Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top" Fill="#168C82" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="집중 모드를 시작할까요?" FontSize="15" FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock x:Name="MessageText" Margin="0,4,0,0" FontSize="12" Foreground="#68758A" TextWrapping="Wrap">
                            작업에 몰입하고 있는 것 같아요.<LineBreak />켜면 중요한 알림만 보여 드려요.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="AcceptButton" Content="집중 시작" Style="{StaticResource PrimarySuggestionButton}"
                                    Click="AcceptButton_Click" AutomationProperties.Name="집중 시작" />
                            <Button x:Name="DeclineButton" Content="나중에" Margin="8,0,0,0" Style="{StaticResource SuggestionButton}"
                                    Click="DeclineButton_Click" AutomationProperties.Name="나중에"
                                    AutomationProperties.HelpText="한동안 다시 제안하지 않습니다." />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- 자동으로 닫히기까지 남은 시간 -->
                <Border Grid.Row="1" Height="3" Margin="18,0,18,8" CornerRadius="1.5" Background="#E6EEEC" ClipToBounds="True">
                    <Border x:Name="CountdownBar" Background="#72B5A6" CornerRadius="1.5" HorizontalAlignment="Stretch" RenderTransformOrigin="0,.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CountdownScale" ScaleX="1" /></Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
