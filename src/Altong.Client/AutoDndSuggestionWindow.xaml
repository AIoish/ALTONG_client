<Window x:Class="Altong.Client.AutoDndSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="Altong 집중 제안"
        Width="384" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None"
        UseLayoutRounding="True" FontFamily="{x:Static services:AppTypography.BodyFont}">
    <!--
        화면 상단 가운데에 내려오는 AutoDND 제안 카드. 집중 진입 제안과 타이머 종료 제안이 같은 카드를 쓴다.
        AI 요약 완료 말풍선과 같은 자리·같은 흑연 유리 카드(Themes/FloatingCard.xaml)를 쓴다.
        클릭해도 작업 중인 창의 포커스를 가져오지 않는다.
        자동 닫힘 시간은 상태 머신이 정하고, 아래 막대는 남은 시간을 보여 주기만 한다.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/FloatingCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12,0,12,18" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideTransform" Y="-16" /></Grid.RenderTransform>
        <Border x:Name="Card" Background="{StaticResource FloatingCardBackground}" BorderBrush="{StaticResource GlassWindowRim}"
                BorderThickness="1" CornerRadius="22" AutomationProperties.Name="집중 모드 제안">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity=".5" ShadowDepth="6" Color="{StaticResource BlackShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="18,16,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 집중은 호박빛: 대시보드 홈의 "집중모드 켜짐" 배지와 같은 색 -->
                    <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" Background="{StaticResource AmberSoft}"
                            BorderBrush="#66E9C995" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock x:Name="IconGlyph" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource BlackAction}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Altong · 집중 제안" FontSize="{StaticResource TypeCaption}" Foreground="{StaticResource BlackMuted}" />
                        <!-- 문구는 코드에서 제안 종류(진입·타이머 종료)에 맞춰 채운다. -->
                        <TextBlock x:Name="TitleText" Margin="0,3,0,0" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold"
                                   Foreground="{StaticResource BlackText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Margin="0,4,0,0" FontSize="{StaticResource TypeLabel}" LineHeight="18"
                                   Foreground="{StaticResource BlackMuted}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="AcceptButton" Style="{StaticResource PrimaryFloatingButton}"
                                    Click="AcceptButton_Click" />
                            <Button x:Name="DeclineButton" Margin="8,0,0,0" Style="{StaticResource FloatingButton}"
                                    Click="DeclineButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- 자동으로 닫히기까지 남은 시간 -->
                <Border Grid.Row="1" Height="3" Margin="20,0,20,10" CornerRadius="1.5" Background="{StaticResource AmberTrack}" ClipToBounds="True">
                    <Border x:Name="CountdownBar" Background="{StaticResource BlackAction}" CornerRadius="1.5" HorizontalAlignment="Stretch" RenderTransformOrigin="0,.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CountdownScale" ScaleX="1" /></Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
