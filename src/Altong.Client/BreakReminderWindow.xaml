<Window x:Class="Altong.Client.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALTONG 휴식 알림"
        Width="360" Height="174"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border Margin="12" Padding="20,18" CornerRadius="22"
            Background="#F5FFFFFF" BorderBrush="#D7E4EC" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#51657E" BlurRadius="24" ShadowDepth="5" Opacity=".24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="#E3F3EF" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <TextBlock Text="☕" FontFamily="Segoe UI Emoji" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="휴식 시간이에요" FontFamily="맑은 고딕" FontSize="17" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock x:Name="RemainingText" FontFamily="맑은 고딕" FontSize="12" Foreground="#168C82" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="방해 금지와 집중 모드는 그대로 유지됩니다. 필요하면 직접 켜거나 꺼 주세요."
                       FontFamily="맑은 고딕" FontSize="12" Foreground="#68758A" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <Button Grid.Row="2" Content="확인" Click="Dismiss_Click" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Padding="16,7" Cursor="Hand" Background="#E3F3EF" BorderBrush="#C9E5DF" Foreground="#16776F"/>
        </Grid>
    </Border>
</Window>
