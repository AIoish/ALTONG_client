<UserControl x:Class="Altong.Client.ReportCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="/Altong.Client;component/Fonts/#Pretendard, Segoe UI, Malgun Gothic"
             Foreground="#F3F4F6" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CalendarMuted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#A6A4AF" />
        </Style>
        <Style x:Key="CalendarCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#303033" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F4F6" /><Setter Property="Background" Value="#2D2A33" />
            <Setter Property="BorderBrush" Value="#48424F" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C9ABFF" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="PC 로컬 시간 · 일정은 시작한 날짜, 리포트는 집중을 종료한 날짜에 표시됩니다." Style="{StaticResource CalendarMuted}" Margin="0,0,0,12" />
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ResponsiveGrid" Margin="0,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="CalendarCard" Style="{StaticResource CalendarCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="PreviousMonthButton" Content="‹" Click="PreviousMonth_Click" AutomationProperties.Name="이전 달" />
                            <TextBlock x:Name="MonthText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="NextMonthButton" Grid.Column="2" Content="›" Click="NextMonth_Click" AutomationProperties.Name="다음 달" />
                        </Grid>
                        <UniformGrid Columns="7" Margin="0,0,0,6">
                            <TextBlock Text="일" HorizontalAlignment="Center" Foreground="#FFA8A8" /><TextBlock Text="월" HorizontalAlignment="Center" />
                            <TextBlock Text="화" HorizontalAlignment="Center" /><TextBlock Text="수" HorizontalAlignment="Center" />
                            <TextBlock Text="목" HorizontalAlignment="Center" /><TextBlock Text="금" HorizontalAlignment="Center" />
                            <TextBlock Text="토" HorizontalAlignment="Center" Foreground="#C9ABFF" />
                        </UniformGrid>
                        <UniformGrid x:Name="DaysPanel" Columns="7" Rows="6" />
                        <WrapPanel Margin="0,12,0,8">
                            <TextBlock Text="● 리포트" Foreground="#C9ABFF" FontSize="11" Margin="0,0,12,0" />
                            <TextBlock Text="◆ 일정" Foreground="#80D5CB" FontSize="11" />
                        </WrapPanel>
                        <Button x:Name="TodayButton" Content="오늘" Click="Today_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border x:Name="ListCard" Grid.Column="2" Style="{StaticResource CalendarCard}">
                    <StackPanel>
                        <TextBlock x:Name="SelectedDateText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScheduleCountText" Foreground="#80D5CB" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,10" />
                        <ListBox x:Name="ScheduleList" MaxHeight="300" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.Style><Style TargetType="ListBox" /></ListBox.Style>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Background="#252329" BorderBrush="#3D5653" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#F3F4F6" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WhenText}" Foreground="#80D5CB" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding LocationText}" Style="{StaticResource CalendarMuted}" FontSize="12" />
                                        <Expander Header="약속 세부사항" Foreground="#A6A4AF" FontSize="12" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding DetailsText}" Style="{StaticResource CalendarMuted}" Margin="0,6,0,0" />
                                        </Expander>
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource CalendarMuted}" FontSize="11" Margin="0,8,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Google Calendar에서 작성" Tag="{Binding}" Click="OpenGoogleCalendar_Click" FontSize="12" BorderBrush="#80D5CB" Margin="0,0,8,4"
                                                    ToolTip="작성 화면을 연 뒤 Google Calendar에서 저장을 눌러 주세요." />
                                            <Button Content="일정 삭제" Tag="{Binding}" Click="DeleteSchedule_Click" FontSize="12" Margin="0,0,0,4"
                                                    ToolTip="대시보드 일정만 삭제합니다. 원본 알림·리포트·Google Calendar 일정은 유지됩니다." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ScheduleEmptyStateText" Text="이 날짜에 저장한 일정이 없습니다." Style="{StaticResource CalendarMuted}" FontSize="12" />
                        <TextBlock x:Name="ReportCountText" Style="{StaticResource CalendarMuted}" FontSize="13" Margin="0,20,0,10" />
                        <Grid>
                            <ListBox x:Name="ReportList" Height="320" BorderThickness="0" Background="Transparent" Foreground="#F3F4F6"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Style><Style TargetType="ListBox" /></ListBox.Style>
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                </Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#45404C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#252329">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CalendarMuted}" FontSize="12" Margin="0,6,0,0" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="리포트 열기" Tag="{Binding}" Click="OpenReport_Click" Margin="0,0,8,4" AutomationProperties.Name="리포트 열기" />
                                                <Button Content="삭제" Tag="{Binding}" Click="DeleteReport_Click" Margin="0,0,0,4" AutomationProperties.Name="리포트 삭제" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyStateText" Text="이 날짜에 저장된 리포트가 없습니다." Style="{StaticResource CalendarMuted}" Margin="12,32" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                        <Button x:Name="LoadMoreButton" Content="더 보기" Click="LoadMore_Click" Margin="0,12,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="HistoryStatusText" Style="{StaticResource CalendarMuted}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RetryButton" Content="다시 불러오기" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
