<Window x:Class="Altong.Client.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="ALTONG · 집중 결과" Width="760" Height="780" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="#242424" Foreground="#F3F4F6"
        FontFamily="./Fonts/#Pretendard, Segoe UI Variable, Segoe UI, Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#F3F4F6" />
        <SolidColorBrush x:Key="MutedText" Color="#A6A4AF" />
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#293737" Offset="0" /><GradientStop Color="#262525" Offset=".28" /><GradientStop Color="#27242B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D1D1D" Offset="0" /><GradientStop Color="#1D1D1D" Offset="1" />
        </LinearGradientBrush>
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2A33" /><Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#48424F" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A679F3" /><Setter TargetName="Surface" Property="Opacity" Value=".9" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".6" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C9ABFF" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#823DE0" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#C9ABFF" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}" />
            <Setter Property="BorderBrush" Value="#303033" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="4" Opacity=".25" /></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="#69707D" CornerRadius="3" Margin="3,0,1,0" />
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource WindowSurface}" BorderBrush="#3A363F" BorderThickness="1" CornerRadius="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="20,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#B787FF" Margin="0,0,10,0" />
                <TextBlock Text="ALTONG" FontSize="12" FontWeight="SemiBold" Foreground="#CAD7E9" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                <Button x:Name="MaximizeButton" Content="□" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="24,18,24,18">
            <Border Width="48" Height="48" CornerRadius="14" Background="#302B38" BorderBrush="#494150" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#C9ABFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="집중 결과" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                <TextBlock x:Name="ReportSourceText" Text="{Binding ReportSource}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,16,0">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="42" FontWeight="Light" Margin="0,6,0,24" />
                        <Border BorderBrush="#41444C" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="차단 알림" Style="{StaticResource Muted}" /><TextBlock Text="{Binding BlockedCount}" FontSize="24" Foreground="#C9ABFF" /></StackPanel>
                            <StackPanel><TextBlock Text="통과 알림" Style="{StaticResource Muted}" /><TextBlock Text="{Binding PassedCount}" FontSize="24" Foreground="#7ED5CB" /></StackPanel>
                            <StackPanel><TextBlock Text="사용 앱" Style="{StaticResource Muted}" /><TextBlock Text="{Binding ApplicationCount}" FontSize="24" /></StackPanel>
                        </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="알림 요약" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding NotificationSummary}" Style="{StaticResource Muted}" />
                        <StackPanel x:Name="LegacySummaryPanel">
                        <ItemsControl ItemsSource="{Binding NotificationHighlights}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="현재는 저장된 알림의 개수와 차단 알림 제목을 요약합니다. AI 내용 요약은 연결 전입니다."
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                        <ItemsControl x:Name="ReportSummaryItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SummaryLoadStatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="알림 확인에서 일정을 저장한 뒤, 대시보드 캘린더에서 Google Calendar 작성 화면을 열 수 있어요." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="앱별 사용 시간" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="AppItemsControl" ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppName}" Margin="8,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" MaxWidth="120" TextAlignment="Right" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percentage}" Maximum="100" Height="4" Margin="8,10,0,0" Foreground="#B787FF" Background="#38333E" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="이번 집중 세션의 앱 사용 내역이 없어요." Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AppItemsControl}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="퀵 답변 초안" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="차단 알림 최대 3건에 대한 공통 문구입니다. 복사 후 내용을 확인하고 수정해 보내세요."
                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                        <ItemsControl x:Name="QuickReplyItemsControl" ItemsSource="{Binding QuickReplies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#41444C" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NotificationTitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Text}" Margin="0,8,0,8" />
                                            <Button Content="문구 복사" Tag="{Binding Text}" Click="CopyQuickReply_Click"
                                                    HorizontalAlignment="Left" FontSize="12" Padding="12,6" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="답변할 차단 알림이 없습니다." Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QuickReplyItemsControl}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="CopyStatusText" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="집중 중 알림" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="NotificationItemsControl" ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#41444C" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                                <Border Grid.Column="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                                    <Border.Style><Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2D2A33" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Background" Value="#243D39" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter Property="Background" Value="#302B38" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style></Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="분류 대기" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Text" Value="통과" /><Setter Property="Foreground" Value="#7ED5CB" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter Property="Text" Value="차단" /><Setter Property="Foreground" Value="#C9ABFF" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="이번 집중 세션에 저장된 알림이 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=NotificationItemsControl}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#212123" BorderBrush="#333136" BorderThickness="0,1,0,0" CornerRadius="0,0,24,24" Padding="24,12">
            <StackPanel>
                <TextBlock x:Name="SaveStatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="SkipSaveButton" Content="저장하지 않고 닫기" Margin="0,0,8,4" Click="CloseButton_Click" />
                    <Button x:Name="SaveReportButton" Content="캘린더에 저장" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" Click="SaveReport_Click" IsDefault="True" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
