<Window x:Class="Altong.Client.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="ALTONG · 기록 결과" Width="760" Height="780" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="#242629" Foreground="#F3F4F6"
        FontFamily="./Fonts/#Pretendard, Segoe UI Variable, Segoe UI, Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#272D33" Offset="0" /><GradientStop Color="#26282B" Offset=".45" /><GradientStop Color="#242629" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#303235" Offset="0" /><GradientStop Color="#2B2D30" Offset="1" />
        </LinearGradientBrush>
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#99D4FA" /><Setter Property="Foreground" Value="#152536" />
            <Setter Property="BorderBrush" Value="#A6D5FF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="18,12" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".9" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".6" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ADB2BD" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}" />
            <Setter Property="BorderBrush" Value="#3D3F42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource WindowSurface}" BorderBrush="#45474A" BorderThickness="1" CornerRadius="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="20,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#A5DCE8" Margin="0,0,10,0" />
                <TextBlock Text="ALTONG" FontSize="12" FontWeight="SemiBold" Foreground="#CAD7E9" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                <Button x:Name="MaximizeButton" Content="□" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="#F3F4F6" Padding="16,10" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="32,24,32,24">
            <TextBlock Text="기록 결과" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,24,0">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="42" FontWeight="Light" Foreground="#A6D5FF" Margin="0,6,0,24" />
                        <Border BorderBrush="#41444C" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="차단 알림" Style="{StaticResource Muted}" /><TextBlock Text="{Binding BlockedCount}" FontSize="24" /></StackPanel>
                            <StackPanel><TextBlock Text="통과 알림" Style="{StaticResource Muted}" /><TextBlock Text="{Binding PassedCount}" FontSize="24" /></StackPanel>
                            <StackPanel><TextBlock Text="사용 앱" Style="{StaticResource Muted}" /><TextBlock Text="{Binding ApplicationCount}" FontSize="24" /></StackPanel>
                        </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="앱별 사용 시간" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="AppItemsControl" ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppName}" Margin="8,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" MaxWidth="120" TextAlignment="Right" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percentage}" Maximum="100" Height="4" Margin="8,10,0,0" Foreground="#A6D5FF" Background="#424650" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="기록된 앱 사용 내역이 없어요." Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AppItemsControl}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="기록 중 알림" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="NotificationItemsControl" ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#41444C" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="1" Foreground="#A6D5FF">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="분류 대기" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Text" Value="통과" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter Property="Text" Value="차단" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="기록 중 수집된 알림이 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=NotificationItemsControl}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#202225" BorderBrush="#34373C" BorderThickness="0,1,0,0" Padding="32,12">
            <Button Content="확인" MinWidth="104" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
        </Border>
    </Grid>
    </Border>
</Window>
