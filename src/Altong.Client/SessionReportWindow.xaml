<Window x:Class="Altong.Client.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="집중 완료 · 집중 리포트" Width="600" Height="660" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{DynamicResource BlackPaper}" Foreground="{DynamicResource BlackText}"
        FontFamily="{x:Static services:AppTypography.BodyFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource BlackTextColor}" />
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource BlackMutedColor}" />
        <SolidColorBrush x:Key="WindowSurface" Color="{StaticResource BlackPaperColor}" />
        <SolidColorBrush x:Key="CardSurface" Color="{StaticResource BlackSurfaceColor}" />
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="Expander" BasedOn="{StaticResource BlackExpander}" />
        <Style TargetType="Button">
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
            <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
            <Setter Property="Background" Value="{StaticResource BlackRaised}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlackAction}" /><Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,18" />
            <Setter Property="Margin" Value="0,0,0,18" />

        </Style>
        <Style x:Key="DetailSection" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="MetricSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlackSurface}" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="{StaticResource SectionGap}" />
        </Style>
        <Style x:Key="SummarySection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlackCanvas}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            <Setter Property="Margin" Value="{StaticResource SectionGap}" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BlackControlRule}" CornerRadius="3" Margin="3,0,1,0" />
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Border x:Name="ReportSurface" Background="{StaticResource WindowSurface}" BorderBrush="{StaticResource BlackControlRule}" BorderThickness="1" CornerRadius="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="20,0,8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlackMuted}" Padding="13,8" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                <Button x:Name="MaximizeButton" Content="□" Foreground="{StaticResource BlackMuted}" Padding="13,8" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                <Button x:Name="ReportCloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlackMuted}" Padding="13,8" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
            </StackPanel>
        </Grid>
        <Border x:Name="ReportCompletionBanner" Grid.Row="1" Background="{StaticResource BlackInput}" BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Padding="22,8,22,16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ReportHeadingText" Text="집중 리포트" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BlackText}" />
                    <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock x:Name="ReportSourceText" Text="{Binding ReportSource}" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="ReportBadgeText" Grid.Column="1" Text="집중 완료" Foreground="{StaticResource BlackSuccess}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <ScrollViewer x:Name="ReportScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,0,14,0">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource MetricSection}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="집중 시간" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Text="{Binding DurationText}" FontSize="26" FontWeight="SemiBold" Margin="0,5,8,0" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="차단 알림" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Text="{Binding BlockedCount}" FontSize="22" Foreground="{StaticResource BlackText}" Margin="0,5,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="통과 알림" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Text="{Binding PassedCount}" FontSize="22" Foreground="{StaticResource BlackSuccess}" Margin="0,5,0,0" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="사용 앱" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Text="{Binding ApplicationCount}" FontSize="22" Margin="0,5,0,0" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SummarySection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="ReloadSummaryButton" Content="새로고침" Click="ReloadSummary_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" Padding="10,6" Visibility="Collapsed" AutomationProperties.Name="AI 요약 새로고침" />
                            <TextBlock Text="AI 요약" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding NotificationSummary}" Style="{StaticResource Muted}" />
                        <StackPanel x:Name="LegacySummaryPanel">
                        <ItemsControl ItemsSource="{Binding NotificationHighlights}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap" LineHeight="22" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <ContentControl x:Name="CalendarSummaryHost" Visibility="Collapsed" Margin="0,10,0,0" />
                        <TextBlock x:Name="SummaryLoadStatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DetailSection}">
                    <Expander x:Name="AppUsageExpander" Header="앱 사용시간" Foreground="{StaticResource BlackSoft}" FontWeight="SemiBold">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl x:Name="AppItemsControl" ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppName}" Margin="8,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" MaxWidth="120" TextAlignment="Right" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percentage}" Maximum="100" Height="4" Margin="8,10,0,0" Foreground="{StaticResource BlackText}" Background="{StaticResource BlackRaised}" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="MoreAppsButton" Click="MoreApps_Click" HorizontalAlignment="Left" Margin="0,8" Visibility="Collapsed" />
                        <TextBlock Text="앱 사용 기록 없음" Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AppItemsControl}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel></Expander>
                </Border>
                <Border Style="{StaticResource DetailSection}">
                    <Expander x:Name="QuickRepliesExpander" Header="답변 초안" Foreground="{StaticResource BlackSoft}" FontWeight="SemiBold">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="복사 후 수정해 사용하세요."
                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                        <ItemsControl x:Name="QuickReplyItemsControl" ItemsSource="{Binding QuickReplies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NotificationTitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Text}" Margin="0,8,0,8" />
                                            <Button Content="문구 복사" Tag="{Binding Text}" Click="CopyQuickReply_Click"
                                                    HorizontalAlignment="Left" FontSize="12" Padding="12,6" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="답변할 알림 없음" Margin="0,8">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QuickReplyItemsControl}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="CopyStatusText" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel></Expander>
                </Border>
                <Border Style="{StaticResource DetailSection}">
                    <Expander x:Name="NotificationsExpander" Header="원본 알림" Foreground="{StaticResource BlackSoft}" FontWeight="SemiBold">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl x:Name="NotificationItemsControl" ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                                <Border Grid.Column="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                                    <Border.Style><Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BlackRaised}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Background" Value="{StaticResource BlackSuccessSurface}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter Property="Background" Value="{StaticResource BlackSurface}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style></Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="분류 대기" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Text" Value="통과" /><Setter Property="Foreground" Value="{StaticResource BlackSuccess}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="False"><Setter Property="Text" Value="차단" /><Setter Property="Foreground" Value="{StaticResource BlackText}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="MoreNotificationsButton" Click="MoreNotifications_Click" HorizontalAlignment="Left" Margin="0,8" Visibility="Collapsed" />
                        <TextBlock Text="알림 없음">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=NotificationItemsControl}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel></Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="{StaticResource BlackInput}" BorderBrush="{StaticResource BlackRule}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="SkipSaveButton" Content="저장하지 않고 닫기" Margin="0,0,8,0" Click="CloseButton_Click" FontSize="12" />
                    <Button x:Name="SaveReportButton" Content="리포트 저장" Style="{StaticResource PrimaryButton}" Click="SaveReport_Click" IsDefault="True" FontSize="12" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
