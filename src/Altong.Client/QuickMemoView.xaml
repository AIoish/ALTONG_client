<UserControl x:Class="Altong.Client.QuickMemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             PreviewKeyDown="Memo_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="MemoEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="#1C1E21" Foreground="#F3F4F6" CaretBrush="#F3F4F6"
                 BorderBrush="#565C66" BorderThickness="1" Padding="9,7" FontSize="13"
                 TextChanged="MemoEditor_TextChanged" AutomationProperties.Name="메모 내용"
                 ToolTip="떠오른 생각을 적어 두세요. Ctrl+Enter로 저장" />
        <Grid Grid.Row="1" Margin="0,7,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="MemoStatusText" Text="Ctrl+Enter로 저장" FontSize="11" Foreground="#ADB2BD"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                       services:MotionBehavior.TextFeedback="True" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ReloadMemoButton" Content="다시 불러오기" Visibility="Collapsed"
                        Click="Reload_Click" Style="{DynamicResource HeaderButton}" Width="94" Height="28" FontSize="11" />
                <Button x:Name="SaveMemoButton" Content="저장" Click="Save_Click" IsEnabled="False"
                        Style="{DynamicResource HeaderButton}" Width="48" Height="28" FontSize="12"
                        Background="#23394B" Foreground="#C4E2FA" AutomationProperties.Name="메모 저장" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="SavedMemoHeading" Grid.Row="2" Text="저장된 메모" FontSize="11" FontWeight="SemiBold"
                   Foreground="#ADB2BD" Margin="0,3,0,7" />
        <Grid Grid.Row="3">
            <TextBlock x:Name="MemoEmptyText" Text="아직 저장한 메모가 없어요" Foreground="#ADB2BD"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ScrollViewer x:Name="MemoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Style="{DynamicResource FlyoutScrollViewer}" PanningMode="VerticalOnly">
                <StackPanel>
                    <ItemsControl x:Name="MemoItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#33373D" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WhenText}" FontSize="10" Foreground="#ADB2BD" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 BorderThickness="0" Padding="0" Background="Transparent" Foreground="#F3F4F6"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.Name="저장된 메모 내용" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreMemosButton" Content="이전 메모 더 보기" Click="More_Click"
                            Style="{DynamicResource HeaderButton}" Width="Auto" Height="28" FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
