<Window x:Class="Altong.Client.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="ALTONG" Width="392" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="{x:Static services:AppTypography.BodyFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="Background" Value="{StaticResource GlassPane}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource GlassPaneHover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource BlackAction}" />
                <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DestructiveDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#3DEBB0A6" />
                <Setter Property="Foreground" Value="{StaticResource BlackError}" />
                <Setter Property="BorderBrush" Value="#70EBB0A6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#55EBB0A6" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource GlassFloating}" BorderBrush="{StaticResource GlassWindowRim}"
            BorderThickness="1" CornerRadius="16" Margin="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource GlassDivider}"
                    BorderThickness="0,0,0,1" Padding="18,14,12,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource BlackAction}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BlackText}" VerticalAlignment="Center" />
                    <Button x:Name="CloseIconButton" Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource BlackMuted}" Background="Transparent" BorderThickness="0"
                            Padding="10,6" Click="Cancel_Click" AutomationProperties.Name="닫기" />
                </Grid>
            </Border>

            <!-- Message Body -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="18,16,18,18"
                       FontSize="13.5" LineHeight="21" Foreground="{StaticResource BlackSoft}" />

            <!-- Footer Actions -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GlassDivider}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsCancel="True"
                            Margin="0,0,8,0" MinWidth="82" />
                    <Button x:Name="ConfirmButton" Content="확인" Click="Confirm_Click"
                            MinWidth="96" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
