<UserControl x:Class="Altong.Client.NotificationSummaryCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             FontFamily="{x:Static services:AppTypography.BodyFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="CalendarBoolVisibility" />
            <SolidColorBrush x:Key="SummaryCardSurface" Color="{StaticResource BlackSurfaceColor}" />
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CalendarMuted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
            </Style>
            <Style x:Key="ScheduleMuted" TargetType="TextBlock" BasedOn="{StaticResource CalendarMuted}">
                <Setter Property="Foreground" Value="{StaticResource BlackSuccessMuted}" />
            </Style>
            <Style x:Key="CalendarButton" TargetType="Button">
                <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="Background" Value="{StaticResource BlackInput}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value=".4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource CalendarButton}" />
            <Style x:Key="CalendarAction" TargetType="Button" BasedOn="{StaticResource CalendarButton}">
                <Setter Property="Background" Value="{StaticResource BlackSuccessSurface}" />
                <Setter Property="Foreground" Value="{StaticResource BlackSuccess}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackSuccessRule}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock x:Name="SummarySourceText" Style="{StaticResource CalendarMuted}" FontSize="12" Margin="0,8,0,12" />
        <ItemsControl x:Name="SummaryItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SummaryCardSurface}" BorderBrush="{StaticResource GlassPaneRule}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding AppDisplayName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource BlackText}" FontSize="14" LineHeight="22" />
                            <ItemsControl ItemsSource="{Binding Schedules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Visibility="{Binding IsScheduleRelated, Converter={StaticResource CalendarBoolVisibility}}" Margin="0,10,0,0">
                                            <Border Background="{StaticResource BlackSuccessSurface}" BorderBrush="{StaticResource BlackSuccessRule}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{StaticResource BlackSuccess}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding ScheduleTitle}" Foreground="{StaticResource BlackText}"
                                                                       FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ScheduleCompactMeta}" Style="{StaticResource ScheduleMuted}"
                                                                   FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ButtonText}" Click="OpenSchedulePopup_Click"
                                                            IsEnabled="{Binding CanAct}" Style="{StaticResource CalendarAction}"
                                                            VerticalAlignment="Center" FontSize="12" Padding="12,6"
                                                            AutomationProperties.Name="{Binding ScheduleTitle, StringFormat={}{0} 일정 등록}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource CalendarMuted}" FontSize="11.5"
                                                       Margin="2,5,0,0" Visibility="{Binding HasStatus, Converter={StaticResource CalendarBoolVisibility}}"
                                                       AutomationProperties.LiveSetting="Polite" services:MotionBehavior.TextFeedback="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="MoreSummariesButton" Click="MoreSummaries_Click" HorizontalAlignment="Left" Padding="10,7" Margin="0,0,0,12" Visibility="Collapsed" />
        <TextBlock x:Name="CalendarLinkHint" Text="저장한 일정은 대시보드 캘린더에서 확인하세요." Style="{StaticResource CalendarMuted}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
