<UserControl x:Class="Altong.Client.DashboardInsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             FontFamily="{x:Static services:AppTypography.BodyFont}"
             Foreground="{DynamicResource BlackText}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <services:AppIconConverter x:Key="AppIcon" />
            <Style TargetType="ItemsControl" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
            </Style>
            <Style x:Key="InsightCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassPane}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="KpiCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassPane}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,10,10" />
            </Style>
            <Style x:Key="PeriodSegment" TargetType="RadioButton">
                <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
                <Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackRaised}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackSelection}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackSelectionRule}" />
                                    <Setter Property="Foreground" Value="{StaticResource BlackAccentText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value=".4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
                <Setter Property="Background" Value="{StaticResource BlackAction}" />
                <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackRaised}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackRule}" />
                                    <Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
                                    <Setter TargetName="Surface" Property="Opacity" Value=".55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource QuietScrollViewer}" />
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource BlackControlRule}" CornerRadius="3" Margin="3,0,1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="InsightsScroll" SizeChanged="InsightsScroll_SizeChanged"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="InsightsContent" Margin="0,2,8,16">
            <!-- Top Bar Row A: 2-way Sub-Tab Switcher + Loading Badge + 3-way Period Switcher -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{StaticResource GlassInput}"
                            BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1"
                            CornerRadius="12" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SubTabOverviewButton" GroupName="InsightSubTabGroup" Tag="Overview"
                                         Content="몰입 현황" IsChecked="True" Checked="SubTabButton_Checked"
                                         Style="{StaticResource PeriodSegment}" AutomationProperties.Name="몰입 현황" />
                            <RadioButton x:Name="SubTabDistractionButton" GroupName="InsightSubTabGroup" Tag="Distraction"
                                         Content="방해 · 맥락" Checked="SubTabButton_Checked"
                                         Style="{StaticResource PeriodSegment}" AutomationProperties.Name="방해 · 맥락" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="PeriodLoadingBadge"
                            Background="{StaticResource BlackSelection}"
                            BorderBrush="{StaticResource BlackSelectionRule}"
                            BorderThickness="1" CornerRadius="6" Padding="8,2"
                            Margin="10,4,0,4" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PeriodLoadingText"
                                   Text="불러오는 중…"
                                   Foreground="{StaticResource BlackAccentText}"
                                   FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" />
                    </Border>
                </WrapPanel>
                <Border Grid.Column="1" Background="{StaticResource GlassInput}"
                        BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1"
                        CornerRadius="12" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PeriodTodayButton" GroupName="InsightPeriodGroup" Tag="Today"
                                     Content="오늘" Checked="PeriodButton_Checked"
                                     Style="{StaticResource PeriodSegment}" AutomationProperties.Name="오늘" />
                        <RadioButton x:Name="PeriodLast7DaysButton" GroupName="InsightPeriodGroup" Tag="Last7Days"
                                     Content="최근 7일" IsChecked="True" Checked="PeriodButton_Checked"
                                     Style="{StaticResource PeriodSegment}" AutomationProperties.Name="최근 7일" />
                        <RadioButton x:Name="PeriodAllTimeButton" GroupName="InsightPeriodGroup" Tag="AllTime"
                                     Content="전체" Checked="PeriodButton_Checked"
                                     Style="{StaticResource PeriodSegment}" AutomationProperties.Name="전체" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty State Card (shown only when !snapshot.HasData) -->
            <Border x:Name="EmptyStateCard" Style="{StaticResource InsightCard}" Padding="28,32" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource BlackInput}"
                            BorderBrush="{StaticResource BlackRule}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource BlackAccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyStateTitleText" Text="집중 기록 없음"
                               FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyStateBodyText"
                               Text="집중 세션 완료 후 데이터가 표시됩니다."
                               Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                               Margin="0,8,0,0" LineHeight="20" />
                </StackPanel>
            </Border>

            <!-- Sub-Tab 1: 몰입 현황 (Asymmetric Bento Grid) -->
            <StackPanel x:Name="OverviewSubTabPanel" Visibility="Visible">
                <!-- Row 1: 2.8 : 7.2 Bento Hero (Streak Tile + 20-Week Grass Heatmap Tile) -->
                <Grid x:Name="HeroBentoRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.8*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="7.2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left Bento Tile: Giant Streak Typographic Anchor -->
                    <Border x:Name="StreakTileCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource InsightCard}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="연속 집중" Style="{StaticResource Muted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border x:Name="PeriodChangeBadge" Grid.Column="1"
                                        Background="{StaticResource BlackSelection}"
                                        BorderBrush="{StaticResource BlackSelectionRule}" BorderThickness="1"
                                        CornerRadius="6" Padding="7,2.5" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="PeriodChangeBadgeText" Foreground="{StaticResource BlackAccentText}"
                                               FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                                <TextBlock x:Name="StreakHeroTitleText" Text="0일"
                                           FontSize="36" FontWeight="Bold" TextWrapping="NoWrap" />
                                <TextBlock x:Name="StreakStateSubtitleText" Text="연속 기록 없음"
                                           Foreground="{StaticResource BlackSoft}"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="StreakMotivationText" Text="오늘 첫 집중 대기"
                                               Foreground="{StaticResource BlackSoft}" FontSize="12" />
                                    <Border x:Name="BestStreakBadge" Background="Transparent"
                                            BorderThickness="0" Padding="0" Margin="0,4,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="BestStreakBadgeText" Foreground="{StaticResource BlackMuted}"
                                                   FontSize="11" TextWrapping="NoWrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right Bento Tile: Full 20-Week Grass Heatmap -->
                    <Border x:Name="HeatmapTileCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource InsightCard}" Margin="0">
                        <StackPanel>
                            <!-- Month Labels aligned to 20 week columns -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="HeatmapMonthItems" Grid.Column="1" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="20" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}"
                                                       FontSize="11" FontWeight="Medium" TextWrapping="NoWrap"
                                                       Margin="2,0,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Weekday labels + 7x20 grass grid -->
                            <Grid x:Name="StreakHeatmapGrid" AutomationProperties.Name="최근 20주 집중 잔디밭" SizeChanged="StreakHeatmapGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <UniformGrid Rows="7" Columns="1" Margin="0,0,4,0">
                                    <TextBlock Text="" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="월" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="수" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="금" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </UniformGrid>
                                <ItemsControl x:Name="StreakHeatmapItems" Grid.Column="1" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="7" Columns="20" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{DynamicResource HeatmapCellHeight}" Margin="2" CornerRadius="3.5"
                                                    ToolTipService.InitialShowDelay="0"
                                                    ToolTipService.ShowDuration="15000"
                                                    ToolTipService.Placement="Right"
                                                    ToolTipService.HorizontalOffset="8"
                                                    ToolTipService.VerticalOffset="-4"
                                                    IsHitTestVisible="{Binding IsInteractive}"
                                                    Focusable="{Binding IsInteractive}"
                                                    AutomationProperties.Name="{Binding TooltipText}">
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True"
                                                             FontFamily="{x:Static services:AppTypography.BodyFont}">
                                                        <Border Background="{StaticResource BlackRaised}"
                                                                BorderBrush="{StaticResource BlackControlRule}"
                                                                BorderThickness="1" CornerRadius="10"
                                                                Padding="12,10" MinWidth="176">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DateHeaderText}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource BlackText}" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding LevelLabelText}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource BlackSuccess}" TextWrapping="NoWrap" />
                                                                </Grid>
                                                                <Border Height="1" Background="{StaticResource BlackRule}" Margin="0,0,0,7" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="집중 시간" Foreground="{StaticResource BlackMuted}" FontSize="11" Margin="0,0,14,3" />
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FocusDurationText}" Foreground="{StaticResource BlackText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0,0,0,3" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="세션 수" Foreground="{StaticResource BlackMuted}" FontSize="11" Margin="0,0,14,3" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SessionCountText}" Foreground="{StaticResource BlackText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0,0,0,3" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="차단 알림" Foreground="{StaticResource BlackMuted}" FontSize="11" Margin="0,0,14,3" />
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlockedCountText}" Foreground="{StaticResource BlackText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0,0,0,3" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="작업 순도" Foreground="{StaticResource BlackMuted}" FontSize="11" Margin="0,0,14,0" />
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WorkPurityText}" Foreground="{StaticResource BlackSuccess}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GlassInput}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource GlassPaneRule}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IntensityLevel}" Value="1">
                                                                <Setter Property="Background" Value="{StaticResource BlackHeatmap1}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IntensityLevel}" Value="2">
                                                                <Setter Property="Background" Value="{StaticResource BlackHeatmap2}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IntensityLevel}" Value="3">
                                                                <Setter Property="Background" Value="{StaticResource BlackHeatmap3}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IntensityLevel}" Value="4">
                                                                <Setter Property="Background" Value="{StaticResource BlackHeatmap4}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="적음" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Border Width="11" Height="11" CornerRadius="2.5" Background="{StaticResource GlassInput}" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1" Margin="1.5,0" />
                                    <Border Width="11" Height="11" CornerRadius="2.5" Background="{StaticResource BlackHeatmap1}" Margin="1.5,0" />
                                    <Border Width="11" Height="11" CornerRadius="2.5" Background="{StaticResource BlackHeatmap2}" Margin="1.5,0" />
                                    <Border Width="11" Height="11" CornerRadius="2.5" Background="{StaticResource BlackHeatmap3}" Margin="1.5,0" />
                                    <Border Width="11" Height="11" CornerRadius="2.5" Background="{StaticResource BlackHeatmap4}" Margin="1.5,0" />
                                    <TextBlock Text="많음" Style="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="최근 20주" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Borderless Flat Metric Strip (4 inline cells separated by 1px hairline rules) -->
                <Border x:Name="KpiStrip" Background="Transparent" BorderBrush="{StaticResource GlassPaneRule}"
                        BorderThickness="0,1,0,1" Padding="0,14" Margin="0,18,0,18">
                    <UniformGrid x:Name="KpiRow" Columns="4">
                        <Border x:Name="KpiCell0" Padding="0,2,12,2" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="총 집중 시간" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="KpiTotalFocusText" Text="0분" FontSize="24" FontWeight="Bold"
                                           Margin="0,6,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="KpiSessionCountText" Text="세션 0회" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="KpiCell1" Padding="16,2,12,2" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Text="방해 차단율" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="KpiBlockRateText" Text="0%" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource BlackAction}"
                                           Margin="0,6,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="KpiBlockRateSubText" Text="차단 0 / 전체 0건" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="KpiCell2" Padding="16,2,12,2" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Text="몰입 유지율" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="FlowProtectionRateText" Text="-" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource BlackAction}"
                                           Margin="0,6,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FlowProtectionSubText" Text="매칭 기록 없음" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="KpiCell3" Padding="16,2,0,2" BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock Text="선별 통과" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="KpiPassedTotalText" Text="0건" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource BlackSuccess}"
                                           Margin="0,6,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="KpiPassedSplitText" Text="긴급 0 · 관련 0" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- Row 3: Full-Width AI Coaching Card -->
                <Border x:Name="CoachingCard" Style="{StaticResource InsightCard}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="AI 집중 코칭" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="CoachingStatusBadgeText" Text="규칙 요약"
                                           Foreground="{StaticResource BlackMuted}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </WrapPanel>
                            <Button x:Name="GenerateCoachingButton" Grid.Column="1" Content="AI 코칭 분석"
                                    Style="{StaticResource ActionButton}" Click="GenerateCoachingButton_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="AI 코칭 분석" />
                        </Grid>

                        <Border x:Name="CoachingLoadingBanner"
                                Background="{StaticResource BlackSelection}"
                                BorderBrush="{StaticResource BlackSelectionRule}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="12,8" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock x:Name="CoachingLoadingText"
                                       Text="AI 분석 중…"
                                       Foreground="{StaticResource BlackAccentText}"
                                       FontSize="12" FontWeight="Medium" />
                        </Border>

                        <TextBlock x:Name="CoachingHeadlineText" FontSize="15" FontWeight="SemiBold"
                                   LineHeight="22" Margin="0,0,0,10" />

                        <ItemsControl x:Name="CoachingFindingsItems" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="{StaticResource BlackAccentText}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource BlackSoft}"
                                                   FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="CoachingActionTipBox" Background="Transparent"
                                BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="실천 팁" Foreground="{StaticResource BlackSuccess}" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,1,10,0" VerticalAlignment="Top" />
                                <TextBlock x:Name="CoachingActionTipText" Grid.Column="1"
                                           Foreground="{StaticResource BlackText}" FontSize="13" LineHeight="20" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="CoachingErrorText" Foreground="{StaticResource BlackError}"
                                   FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sub-Tab 2: 방해 · 맥락 -->
            <StackPanel x:Name="DistractionSubTabPanel" Visibility="Collapsed">
                <!-- Row 1: Full-Width Work Purity Donut Ring + Self-Distraction Trend -->
                <Border x:Name="QualityCard" Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="집중 이탈 · 작업 순도" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <Grid x:Name="QualityInnerGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5.5*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="4.5*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Left: Donut Ring + Vertical Legend -->
                            <Grid x:Name="WorkPurityDonutGrid" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="96" Height="96">
                                    <Ellipse Width="96" Height="96" Stroke="{StaticResource BlackRule}" StrokeThickness="10" />
                                    <Path x:Name="WorkPurityArcPath" Stroke="{StaticResource BlackAction}" StrokeThickness="10" />
                                    <Path x:Name="NeutralPurityArcPath" Stroke="{StaticResource BlackMuted}" StrokeThickness="10" />
                                    <Path x:Name="LeisurePurityArcPath" Stroke="{StaticResource BlackError}" StrokeThickness="10" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="WorkPurityCenterText" Text="-" FontSize="19" FontWeight="Bold"
                                                   HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Text="순수 작업" FontSize="10" Foreground="{StaticResource BlackMuted}"
                                                   HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BlackAction}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="순수 작업" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="WorkPurityPercentText" Grid.Column="2" Text="0%" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" Margin="12,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BlackMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="메신저·웹" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="NeutralPurityPercentText" Grid.Column="2" Text="0%" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" Margin="12,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BlackError}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="비작업" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="LeisurePurityPercentText" Grid.Column="2" Text="0%" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Right: Deep Focus Summary + Clean 2-Line Self-Distraction Callout -->
                            <Border x:Name="QualityRightColumn" Grid.Column="2" Grid.Row="0"
                                    BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="1,0,0,0"
                                    Padding="20,4,0,4" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="몰입 밀도" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBlock x:Name="DeepFocusSummaryText"
                                               Text="깊은 몰입(25분+) 0회 · 평균 0분"
                                               Foreground="{StaticResource BlackSoft}" FontSize="13" FontWeight="Medium" />

                                    <Border x:Name="SelfDistractionCallout" Background="Transparent"
                                            BorderBrush="{StaticResource GlassPaneRule}" BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0" Margin="0,12,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="직접 확인 최다" Style="{StaticResource Muted}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border x:Name="SelfDistractionChangeBadge" Grid.Column="1"
                                                        Background="{StaticResource BlackSuccessSurface}"
                                                        BorderBrush="{StaticResource BlackSuccessRule}" BorderThickness="1"
                                                        CornerRadius="6" Padding="7,2.5" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                    <TextBlock x:Name="SelfDistractionChangeBadgeText"
                                                               Foreground="{StaticResource BlackSuccess}"
                                                               FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="SelfDistractionText" Foreground="{StaticResource BlackText}"
                                                       FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 24-Hour Focus vs Notification Distribution Card -->
                <Border x:Name="HourlyChartCard" Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="시간대별 집중 · 방해 패턴" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="GoldenHourBadge" Background="{StaticResource BlackSelection}"
                                        BorderBrush="{StaticResource BlackSelectionRule}" BorderThickness="1"
                                        CornerRadius="7" Padding="9,4" Margin="0,0,8,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource BlackAction}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="GoldenHourBadgeText" Foreground="{StaticResource BlackAction}"
                                                   FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DistractionPeakBadge" Background="{StaticResource BlackInput}"
                                        BorderBrush="{StaticResource BlackError}" BorderThickness="1"
                                        CornerRadius="7" Padding="9,4" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource BlackError}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DistractionPeakBadgeText" Foreground="{StaticResource BlackError}"
                                                   FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BlackAction}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="집중 시간" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BlackError}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="수신 알림" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="HourlyChartGrid" Height="112" AutomationProperties.Name="24시간 집중 및 방해 알림 분포">
                            <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,1,0,1"
                                    Height="88" VerticalAlignment="Top" IsHitTestVisible="False" />
                            <Border Background="{StaticResource BlackRaised}" Height="1"
                                    VerticalAlignment="Top" Margin="0,44,0,0" IsHitTestVisible="False" />
                            <ItemsControl x:Name="HourlyChartItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" ToolTipService.InitialShowDelay="0"
                                              Focusable="True" AutomationProperties.Name="{Binding TooltipText}">
                                            <Grid.ToolTip>
                                                <ToolTip Background="{StaticResource BlackRaised}"
                                                         Foreground="{StaticResource BlackText}"
                                                         BorderBrush="{StaticResource BlackRule}"
                                                         Padding="10,6"
                                                         FontFamily="./Fonts/#Pretendard, Segoe UI, Malgun Gothic">
                                                    <TextBlock Text="{Binding TooltipText}" />
                                                </ToolTip>
                                            </Grid.ToolTip>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="88" />
                                                <RowDefinition Height="24" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="1.5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.5" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Height="{Binding FocusBarHeight}" VerticalAlignment="Bottom"
                                                        CornerRadius="2,2,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BlackMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGoldenHour}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource BlackAction}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Grid.Column="2" Height="{Binding NotificationBarHeight}" VerticalAlignment="Bottom"
                                                        CornerRadius="2,2,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BlackError}" />
                                                            <Setter Property="Opacity" Value="0.55" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDistractionPeak}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding AxisLabel}" FontSize="10"
                                                       Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2-Column Top 5 Cards -->
                <Grid x:Name="TopListsRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left Card: Top 5 Distractors -->
                    <Border x:Name="TopDistractorsCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource InsightCard}" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="주요 방해원 TOP 5" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <TextBlock x:Name="TopDistractorsEmptyText" Text="방해 알림 기록 없음"
                                       Style="{StaticResource Muted}" FontSize="13" Margin="0,8" Visibility="Collapsed" />
                            <ItemsControl x:Name="TopDistractorsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayLabel}" ToolTip="{Binding DisplayLabel}"
                                                           FontSize="13" FontWeight="Medium"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountSummaryText}"
                                                           Style="{StaticResource Muted}" FontSize="11"
                                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Value="{Binding BlockRatePercent, Mode=OneWay}" Maximum="100" Height="5"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource BlackAction}"
                                                             Background="{StaticResource BlackRule}" BorderThickness="0" />
                                                <TextBlock Grid.Column="1" Text="{Binding BlockRateText}"
                                                           Foreground="{StaticResource BlackAccentText}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Top 5 Work Contexts -->
                    <Border x:Name="TopWorkContextsCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource InsightCard}" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="작업 맥락별 보호 현황 TOP 5" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <TextBlock x:Name="TopWorkContextsEmptyText" Text="작업 중 알림 기록 없음"
                                       Style="{StaticResource Muted}" FontSize="13" Margin="0,8" Visibility="Collapsed" />
                            <ItemsControl x:Name="TopWorkContextsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding ProcessName, Converter={StaticResource AppIcon}}"
                                                   Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ProcessName}"
                                                           FontSize="13" FontWeight="Medium"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CountSummaryText}" Style="{StaticResource Muted}"
                                                           FontSize="11" Margin="0,2,0,0" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FocusDurationText}"
                                                       Foreground="{StaticResource BlackSoft}" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="StatusErrorText" Foreground="{StaticResource BlackError}"
                       FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
