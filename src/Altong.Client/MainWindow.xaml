<Window x:Class="Altong.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,20"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       Text="Altong" />
            <TextBlock x:Name="FocusModeStatusText"
                       Margin="0,0,0,12"
                       HorizontalAlignment="Center"
                       FontSize="16" />
            <Button x:Name="FocusModeToggleButton"
                    MinWidth="160"
                    Padding="16,8"
                    Click="FocusModeToggleButton_Click" />
        </StackPanel>
    </Grid>
</Window>
