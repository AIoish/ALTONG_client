<Window x:Class="Altong.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,20"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       Text="Altong" />
            <TextBlock x:Name="FocusModeStatusText"
                       Margin="0,0,0,12"
                       HorizontalAlignment="Center"
                       FontSize="16" />
            <TextBlock x:Name="WindowsNotificationModeText"
                       Width="520"
                       Margin="0,0,0,16"
                       HorizontalAlignment="Center"
                       Foreground="#5F6368"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FocusRoutineStatusText"
                       Text="집중 모드를 켜면 타이머가 시작됩니다."
                       HorizontalAlignment="Center"
                       Foreground="#16776F"
                       Margin="0,0,0,16" />
            <Button x:Name="FocusModeToggleButton"
                    MinWidth="160"
                    Padding="16,8"
                    Click="FocusModeToggleButton_Click" />
        </StackPanel>

        <!-- 우측 하단 디버그 모니터 열기 버튼 -->
        <Button x:Name="OpenDebugConsoleButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="16"
                Padding="8,4"
                FontSize="11"
                Background="#F8F9FA"
                BorderBrush="#DADCE0"
                Foreground="#5F6368"
                Cursor="Hand"
                Content="🛠️ 디버그 모니터"
                Click="OpenDebugConsoleButton_Click" />
    </Grid>
</Window>
