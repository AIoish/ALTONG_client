<UserControl x:Class="Altong.Client.NotificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             xmlns:local="clr-namespace:Altong.Client"
             FontFamily="pack://application:,,,/Altong.Client;component/Fonts/#Pretendard, Segoe UI Variable, Segoe UI, Malgun Gothic"
             Foreground="#F3F4F6" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
        상단 노치에서 아래로 늘어나는 알림 패널의 내용. 검은 바탕과 테두리는 NotificationDockWindow가
        노치와 한 도형으로 그리므로 이 컨트롤은 배경 없이 내용만 그린다.
    -->
    <UserControl.Resources>
        <!-- DashboardWindow와 같은 하늘색 포인트. 패널 바탕은 노치와 같은 검정이다. -->
        <SolidColorBrush x:Key="PrimaryText" Color="#F3F4F6" />
        <SolidColorBrush x:Key="MutedText" Color="#ADB2BD" />
        <SolidColorBrush x:Key="Accent" Color="#A6D5FF" />
        <SolidColorBrush x:Key="ReadCardSurface" Color="#27292C" />
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#272D33" Offset="0" />
            <GradientStop Color="#26282B" Offset=".45" />
            <GradientStop Color="#242629" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#303235" Offset="0" />
            <GradientStop Color="#2B2D30" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelSurface" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="DistinctTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDistinctTitle}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UrgencyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#99C8BB" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Urgency}" Value="4">
                    <Setter Property="Foreground" Value="#DFC28E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Urgency}" Value="5">
                    <Setter Property="Foreground" Value="#EEAA92" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRead}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlyoutScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" Background="#69707D" CornerRadius="3" Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="#ADB2BD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlyoutScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="6" Margin="6,0,0,0"
                                       Style="{StaticResource FlyoutScrollBar}" Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#35383F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value=".35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#35383F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#23394B" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#202225" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
        </Style>
        <Style x:Key="NotchSettingsExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ContentPresenter x:Name="SettingsContent" ContentSource="Content" Visibility="Collapsed" />
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{StaticResource MutedText}" Cursor="Hand"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="노치 설정 펼치기">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SettingsToggle" Background="Transparent" CornerRadius="6" Padding="7,6"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SettingsArrow" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="노치 설정" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsToggle" Property="Background" Value="#202225" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SettingsToggle" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SettingsArrow" Property="Text" Value="&#xE70D;" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SettingsContent" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 투명 바탕도 마우스가 머무는 영역으로 쳐서, 목록과 상세 사이를 오가도 패널을 벗어난 것으로 보지 않는다. -->
    <Grid x:Name="PanelRoot" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
            <ColumnDefinition x:Name="ListColumn" Width="316" />
        </Grid.ColumnDefinitions>
        <Border x:Name="DetailPanel" Grid.Column="0" Visibility="Collapsed"
                Style="{StaticResource PanelSurface}" BorderBrush="#26FFFFFF" BorderThickness="0,0,1,0" Padding="20">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="알림 상세" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="DetailPinButton" Style="{StaticResource PinButton}" Click="Pin_Click"
                                      ToolTip="알림 패널 함께 고정" AutomationProperties.Name="상세 패널 고정" />
                        <Button Style="{StaticResource HeaderButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="CloseDetail_Click"
                                ToolTip="상세 닫기" AutomationProperties.Name="상세 닫기" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Style="{StaticResource FlyoutScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel x:Name="DetailContent" Margin="0,0,10,0">
                        <TextBlock Text="{Binding AppDisplayName}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Sender}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReceivedText}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,22" />
                        <TextBlock x:Name="DetailTitle" Text="{Binding Title}" Style="{StaticResource DistinctTitle}"
                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding Body}" FontSize="14" LineHeight="24" TextWrapping="Wrap" />
                        <Border Margin="0,24,0,0" BorderBrush="#3D3F42" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <TextBlock Text="읽은 알림은 다시 확인하거나 ‘읽은 알림 삭제’로 목록에서 지울 수 있어요."
                                       Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="ListPanel" Grid.Column="1" Style="{StaticResource PanelSurface}" Padding="16">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ListHeading" Text="중요 알림" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="CountText" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="ListPinButton" Style="{StaticResource PinButton}" Click="Pin_Click"
                                      ToolTip="알림 패널 함께 고정" AutomationProperties.Name="목록 패널 고정" />
                        <Button Style="{StaticResource HeaderButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="CloseList_Click"
                                ToolTip="알림 패널 닫기" AutomationProperties.Name="알림 패널 닫기" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid x:Name="NotificationListContent">
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="12">
                        <Border Width="40" Height="40" Background="#303841" CornerRadius="10" Margin="0,0,0,16">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}"
                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="아직 중요한 알림이 없어요" TextAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="알림이 도착하면 미니바가 알려드려요."
                                   Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer x:Name="ListScroll" Style="{StaticResource FlyoutScrollViewer}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="NotificationItems" Margin="0,0,5,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Notification_Click" Tag="{Binding}" Margin="0,0,0,10"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand" Foreground="{StaticResource PrimaryText}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="{DynamicResource CardSurface}" BorderBrush="#3D3F42"
                                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource ReadCardSurface}" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#373A3F" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#35383F" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#8FBDE7" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Card" Property="Opacity" Value=".75" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AppDisplayName}" FontSize="11" Foreground="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource MutedText}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Sender}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="CardTitle" Text="{Binding Title}" Style="{StaticResource DistinctTitle}"
                                                       Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Body}" Margin="0,9,0,0" Foreground="{StaticResource MutedText}" FontSize="13"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" MaxHeight="40" />
                                            <Grid Margin="0,14,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="4" Height="4" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding ReadText}" FontSize="11" Foreground="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="#202225" CornerRadius="4" Padding="6,3">
                                                    <TextBlock Text="{Binding UrgencyText}" Style="{StaticResource UrgencyLabel}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                    <local:QuickMemoView x:Name="MemoView" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Grid x:Name="NotificationBulkActions" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MarkAllReadButton" Content="모두 읽기" Click="MarkAllRead_Click"
                                Style="{StaticResource HeaderButton}" Width="Auto" Height="28" FontSize="11"
                                Background="#303235" ToolTip="이번 집중 세션의 알림을 모두 읽음으로 표시"
                                AutomationProperties.Name="모두 읽기" />
                        <Button x:Name="DeleteReadButton" Grid.Column="2" Content="읽은 알림 삭제" Click="DeleteRead_Click"
                                Style="{StaticResource HeaderButton}" Width="Auto" Height="28" FontSize="11"
                                Background="#303235" ToolTip="이번 집중 세션의 목록에서 읽은 알림만 삭제. 대시보드 기록은 유지됩니다."
                                AutomationProperties.Name="읽은 알림 삭제" />
                    </Grid>
                    <Border BorderBrush="#33373D" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="QuickMemoButton" Click="QuickMemo_Click" Style="{StaticResource UtilityButton}"
                                        AutomationProperties.Name="빠른 메모" ToolTip="메모 작성과 저장된 메모 확인">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MemoButtonIcon" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="MemoButtonLabel" Text="빠른 메모" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopFocusButton" Grid.Column="2" Click="StopFocus_Click" Style="{StaticResource UtilityButton}"
                                        AutomationProperties.Name="집중 끄기" ToolTip="집중 모드 끄기">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="집중 끄기" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UtilityStatusText" Visibility="Collapsed" FontSize="11" Foreground="#EEAA92"
                                       TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="DashboardButton" Style="{StaticResource HeaderButton}" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Dashboard_Click" ToolTip="대시보드 활성화/최소화"
                                AutomationProperties.Name="대시보드 활성화/최소화" />
                        <Expander x:Name="NotchAppearanceExpander" Grid.ColumnSpan="2" Header="노치 설정" Foreground="{StaticResource MutedText}" FontSize="11"
                                  Style="{StaticResource NotchSettingsExpander}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" ExpandDirection="Up">
                            <StackPanel Margin="0,0,0,8">
                    <!-- 화면 맨 위 띠. 바탕화면(기본)은 띠 아래 실제 바탕화면을 그대로 비춘다. -->
                    <Grid x:Name="BandStyleBar" Margin="0,8,0,0">
                        <TextBlock Text="상단 띠" FontSize="11" Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Border Background="#202225" CornerRadius="8" Padding="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BandBlackButton" Content="검정" Tag="{x:Static services:TopBandStyle.Black}"
                                        Click="BandStyle_Click" Style="{StaticResource HeaderButton}" Width="60" Height="26" Margin="1" FontSize="11"
                                        ToolTip="검은 띠. 접힌 노치가 띠와 이어져 보입니다." AutomationProperties.Name="상단 띠 검정" />
                                <Button x:Name="BandWallpaperButton" Content="바탕화면" Tag="{x:Static services:TopBandStyle.Wallpaper}"
                                        Click="BandStyle_Click" Style="{StaticResource HeaderButton}" Width="60" Height="26" Margin="1" FontSize="11"
                                        ToolTip="띠 자리에 바탕화면을 그대로 보여 줍니다. 바탕화면을 바꾸면 함께 바뀝니다."
                                        AutomationProperties.Name="상단 띠 바탕화면" />
                            </StackPanel>
                        </Border>
                    </Grid>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
