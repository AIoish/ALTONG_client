<UserControl x:Class="Altong.Client.SummaryBlendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             Focusable="False" AutomationProperties.Name="AI가 알림을 섞어 요약하는 중">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <services:AppIconConverter x:Key="AppIcon" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 위쪽 알림 카드들이 차례로 가운데 요약 카드로 모여 섞인다. 동작 줄이기에서는 움직임 없이 놓아 둔다. -->
    <Grid x:Name="Stage" Height="196" ClipToBounds="True">
        <Canvas x:Name="ChipLayer" />
        <Border x:Name="SummaryTarget" Width="236" Height="76" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"
                CornerRadius="12" BorderThickness="1" Background="{StaticResource BlackSelection}" BorderBrush="{StaticResource BlackSelectionRule}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="TargetScale" /></Border.RenderTransform>
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource BlackAction}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="AI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlackActionText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="SkeletonLine1" Height="8" CornerRadius="4" Background="{StaticResource BlackAccentText}" Opacity=".55" HorizontalAlignment="Left" Width="150" />
                    <Border x:Name="SkeletonLine2" Height="8" CornerRadius="4" Background="{StaticResource BlackAccentText}" Opacity=".4" HorizontalAlignment="Left" Width="120" Margin="0,8,0,0" />
                    <Border x:Name="SkeletonLine3" Height="8" CornerRadius="4" Background="{StaticResource BlackAccentText}" Opacity=".3" HorizontalAlignment="Left" Width="84" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
