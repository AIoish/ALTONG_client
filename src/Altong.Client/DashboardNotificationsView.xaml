<UserControl x:Class="Altong.Client.DashboardNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Altong.Client.Services"
             FontFamily="{x:Static services:AppTypography.BodyFont}" Foreground="{DynamicResource BlackText}" Background="Transparent"
             UseLayoutRounding="True">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource BlackMuted}" /></Style>
        <Style TargetType="Button">
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
            <Setter Property="Background" Value="{StaticResource GlassPaneHover}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavSelectedRule}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" /><Setter Property="MinHeight" Value="36" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="{StaticResource TypeControl}" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlackAction}" /><Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="16,0" />
        </Style>
        <Style x:Key="StateTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="8,2" /><Setter Property="Background" Value="#1FE9C995" />
            <Style.Triggers><DataTrigger Binding="{Binding Record.IsPassed}" Value="True"><Setter Property="Background" Value="#1FB9D6C2" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StateTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TypeCaption}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource BlackAction}" />
            <Style.Triggers><DataTrigger Binding="{Binding Record.IsPassed}" Value="True"><Setter Property="Foreground" Value="{StaticResource BlackSuccess}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BlackMuted}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource TypeControl}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Padding" Value="12,0" /><Setter Property="Height" Value="32" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource GlassPane}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1FFFF0DC" /><Setter TargetName="Surface" Property="BorderBrush" Value="#2EFFF0DC" /><Setter Property="Foreground" Value="{StaticResource BlackText}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Box" Width="18" Height="18" Background="{StaticResource BlackInput}" BorderBrush="{StaticResource BlackControlRule}" BorderThickness="1" CornerRadius="4">
                    <Path x:Name="Mark" Data="M 3,8 L 7,12 L 13,4" Stroke="{StaticResource BlackActionText}" StrokeThickness="1.8" Visibility="Collapsed" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource BlackAction}" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NotificationList" TargetType="ListBox">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border x:Name="ListSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource BlackControlRule}" CornerRadius="3" Margin="3,0,1,0" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="ToolTip" Value="{Binding AppName}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Padding" Value="10,8" /><Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackSelection}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="FontSize" Value="{StaticResource TypeControl}" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="36" /><Setter Property="MaxWidth" Value="200" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface" Background="#1AFFF0DC" BorderBrush="#29FFF0DC" BorderThickness="1" CornerRadius="12" />
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <DockPanel Margin="14,0" IsHitTestVisible="False">
                        <TextBlock DockPanel.Dock="Right" Text=" ▾" VerticalAlignment="Center" />
                        <TextBlock x:Name="AppFilterLabel" Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" VerticalOffset="6">
                        <Border Background="{StaticResource BlackRaised}" BorderBrush="{StaticResource BlackRule}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="200" MaxWidth="300" MaxHeight="280">
                            <ScrollViewer><ItemsPresenter /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <!-- 도안 1행: [전체 · 차단 · 통과] [검색] [모든 앱 ▾] -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Padding="3" CornerRadius="13" Background="#0DFFF0DC" BorderBrush="#1AFFF0DC" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTab" GroupName="HistoryStatus" Tag="all" Content="전체" IsChecked="True" Checked="StatusFilter_Changed" Style="{StaticResource FilterTab}" />
                    <RadioButton x:Name="BlockedTab" GroupName="HistoryStatus" Tag="blocked" Content="차단" Checked="StatusFilter_Changed" Style="{StaticResource FilterTab}" Margin="2,0" />
                    <RadioButton x:Name="PassedTab" GroupName="HistoryStatus" Tag="passed" Content="통과" Checked="StatusFilter_Changed" Style="{StaticResource FilterTab}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource GlassInput}" BorderBrush="#24FFF0DC" BorderThickness="1" CornerRadius="12" Height="36">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource BlackMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="{StaticResource BlackText}" CaretBrush="{StaticResource BlackText}" BorderThickness="0" Padding="0,0,10,0" VerticalContentAlignment="Center" FontSize="{StaticResource TypeControl}" MaxLength="200" TextChanged="Search_TextChanged" AutomationProperties.Name="알림 검색 · 발신자, 제목, 본문" ToolTip="발신자·제목·본문 검색" />
                    <TextBlock Grid.Column="1" Text="발신자·제목·본문 검색" Foreground="{StaticResource BlackMuted}" FontSize="{StaticResource TypeControl}" VerticalAlignment="Center" Margin="2,0,10,0" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <ComboBox x:Name="AppFilter" Grid.Column="4" DisplayMemberPath="Label" SelectionChanged="AppFilter_Changed" AutomationProperties.Name="알림 앱 필터" ToolTip="{Binding SelectedItem.AppName, RelativeSource={RelativeSource Self}}" />
        </Grid>
        <!-- ⋯ 메뉴의 [여러 개 선택]을 켰거나 고른 알림이 있을 때만 나온다 -->
        <Border x:Name="SelectionBar" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10" Padding="5" CornerRadius="13" Background="#0DFFF0DC" BorderBrush="#1AFFF0DC" BorderThickness="1">
            <DockPanel>
                <Button x:Name="DoneSelectingButton" DockPanel.Dock="Right" Content="완료" Click="DoneSelecting_Click" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" />
                <Button x:Name="SelectPageButton" Content="페이지 전체 선택" Click="SelectPage_Click" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" />
                <Button x:Name="DismissSelectedButton" Content="선택 제거" Click="DismissSelected_Click" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" Margin="6,0" />
                <TextBlock x:Name="SelectedCountText" FontSize="{StaticResource TypeLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </DockPanel>
        </Border>
        <Grid x:Name="ReadingLayout" Grid.Row="2" SizeChanged="ReadingLayout_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
            <Border x:Name="ListPane" Background="{StaticResource GlassPane}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="NotificationsList" Style="{StaticResource NotificationList}" Background="Transparent" Foreground="{StaticResource BlackText}" BorderThickness="0" Padding="10" SelectionChanged="Notification_SelectionChanged" PreviewMouseLeftButtonUp="Notification_MouseUp" PreviewKeyDown="Notification_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="알림 목록">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <StackPanel>
                                    <!-- 같은 집중의 첫 알림 위에만: "오늘 18:27 – 18:56 집중 · 6개" -->
                                    <TextBlock x:Name="GroupHeader" Text="{Binding GroupHeaderText}" FontSize="{StaticResource TypeLabel}" Foreground="{StaticResource BlackMuted}" Padding="14,12,14,4" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14"><ContentPresenter /></Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasGroupHeader}" Value="True"><Setter TargetName="GroupHeader" Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsFirstGroup}" Value="True"><Setter TargetName="GroupHeader" Property="Padding" Value="14,8,14,4" /></DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource GlassPane}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1AE9C995" /><Setter TargetName="Row" Property="BorderBrush" Value="#59E9C995" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="13,11">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,7,10,0" AutomationProperties.Name="{Binding TitleText, StringFormat='제거할 알림 선택: {0}'}">
                                    <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource HistoryCheckBox}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="select"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style></CheckBox.Style>
                                </CheckBox>
                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="{StaticResource GlassPaneHover}" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="20" Height="20" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RowTimeText}" ToolTip="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="{StaticResource TypeCaption}" Margin="8,2,0,0" />
                                        <TextBlock Text="{Binding RowTitleText}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppName}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource BlackSoft}" FontSize="{StaticResource TypeBody}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource StateTag}" VerticalAlignment="Top" Margin="12,1,0,0"><TextBlock Text="{Binding ClassificationText}" Style="{StaticResource StateTagText}" /></Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock x:Name="EmptyStateText" Text="알림 불러오는 중…" FontWeight="SemiBold" TextAlignment="Center" />
                        <Button x:Name="ResetFiltersButton" Content="필터 초기화" Click="ResetFilters_Click" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DetailPane" Grid.Column="2" Background="{StaticResource GlassPane}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="DetailEmptyText" Text="알림을 고르면 내용이 여기에 보여요" Style="{StaticResource Muted}" FontSize="{StaticResource TypeBody}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    <Grid x:Name="DetailContent" Visibility="Collapsed" Margin="20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button x:Name="BackToListButton" Content="‹ 목록으로" Click="BackToList_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,12" />
                        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Padding="0,0,8,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource GlassPaneHover}" Margin="0,0,10,0">
                                        <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="22" Height="22" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SenderText}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailMetaText}" Style="{StaticResource Muted}" FontSize="{StaticResource TypeLabel}" ToolTip="{Binding AppName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding TitleText}" FontSize="{StaticResource TypeSection}" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <TextBlock x:Name="DetailBodyText" Text="{Binding BodyText}" FontSize="{StaticResource TypeBody}" LineHeight="24" Foreground="{StaticResource BlackSoft}" Margin="0,8,0,0" />
                                <Border x:Name="FoundSchedulePanel" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,12" CornerRadius="14" Background="#1AB9D6C2" BorderBrush="#47B9D6C2" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="찾은 일정" FontSize="{StaticResource TypeLabel}" FontWeight="SemiBold" Foreground="{StaticResource BlackSuccess}" />
                                        <TextBlock x:Name="FoundScheduleText" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="답장 문구" Style="{StaticResource Muted}" FontSize="{StaticResource TypeLabel}" Margin="0,0,0,8" />
                            <Button x:Name="CopyReplyButton" Click="CopyReply_Click" HorizontalContentAlignment="Left" AutomationProperties.Name="답장 문구 복사">
                                <TextBlock x:Name="CopyReplyText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="SaveScheduleButton" Content="캘린더에 저장" Click="SaveSchedule_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" />
                                <Button x:Name="OpenInReportButton" Content="리포트에서 보기" Click="OpenInReport_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- 도안에 없는 줄: 페이지가 둘 이상이거나 안내·재시도·새 알림이 있을 때만 보인다 -->
        <DockPanel Grid.Row="3">
            <Button x:Name="NewArrivalsButton" DockPanel.Dock="Right" Click="Refresh_Click" Foreground="{StaticResource BlackAccentText}" Background="{StaticResource BlackSelection}" BorderBrush="{StaticResource BlackSelectionRule}" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" Margin="8,10,0,0" Visibility="Collapsed" />
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="다시 시도" Click="Retry_Click" Visibility="Collapsed" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" Margin="8,10,0,0" />
            <StackPanel x:Name="PaginationPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ResultCountText" Style="{StaticResource Muted}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="PreviousPageButton" Content="이전" Click="PreviousPage_Click" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" />
                <TextBlock x:Name="PageNumberText" FontSize="{StaticResource TypeLabel}" Margin="10,0" VerticalAlignment="Center" />
                <Button x:Name="NextPageButton" Content="다음" Click="NextPage_Click" MinHeight="30" Padding="12,0" FontSize="{StaticResource TypeLabel}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" Margin="2,10,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
