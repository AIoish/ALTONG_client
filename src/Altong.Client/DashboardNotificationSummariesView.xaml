<UserControl x:Class="Altong.Client.DashboardNotificationSummariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button x:Name="CloseSummaryButton" Content="요약 닫기" Click="Back_Click" HorizontalAlignment="Right" FontSize="11" Padding="10,6" Margin="0,0,0,10" />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock x:Name="SummaryHeadingText" Text="AI 요약" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
            <TextBlock x:Name="SummaryCountText" Foreground="#C9ABFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,8" />
            <Button x:Name="ReloadSummaryButton" Content="요약 새로고침" Click="ReloadSummary_Click" FontSize="12" Padding="12,7" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Text="핵심 내용을 읽고, 일정이 있으면 캘린더에 추가하세요." Foreground="#A6A4AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock x:Name="SummaryLoadStatusText" Foreground="#DDC8FF" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="SummaryEmptyState" Background="#25232A" BorderBrush="#3B3742" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AI 요약이 아직 준비되지 않았어요." FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="요약이 도착하면 이곳에 표시됩니다. 앱 카드를 눌러 원본 알림을 먼저 확인할 수 있어요." Foreground="#A6A4AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <ContentControl x:Name="SummaryCardsHost" />
        <Button x:Name="LoadMoreSummariesButton" Content="이전 요약 더 보기" Click="LoadMoreSummaries_Click" Visibility="Collapsed" HorizontalAlignment="Left" FontSize="12" Padding="12,7" Margin="0,0,0,16" />
    </StackPanel>
</UserControl>
