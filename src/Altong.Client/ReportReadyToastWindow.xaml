<Window x:Class="Altong.Client.ReportReadyToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="Altong 리포트 알림"
        Width="368" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None"
        UseLayoutRounding="True" FontFamily="{x:Static services:AppTypography.BodyFont}">
    <!--
        AI 요약이 끝났음을 알리는 트레이 말풍선. 작업 표시줄 알림 영역 근처(작업 영역 오른쪽 아래)에 뜬다.
        대시보드와 같은 흑연 유리(왼쪽 위에 호박빛이 번진 판, 윗변이 밝은 테두리)를 쓰고, 눌러도 작업 중인 창의 포커스를 가져가지 않는다.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToastButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Background" Value="{StaticResource GlassPaneHover}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="BorderBrush" Value="{StaticResource NavSelectedRule}" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".85" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="PrimaryToastButton" TargetType="Button" BasedOn="{StaticResource ToastButton}">
                <Setter Property="Background" Value="{StaticResource BlackAction}" />
                <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12,12,12,12" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideTransform" Y="14" /></Grid.RenderTransform>
        <Border x:Name="Card" BorderBrush="{StaticResource GlassWindowRim}" BorderThickness="1" CornerRadius="22"
                AutomationProperties.LiveSetting="Polite">
            <Border.Background>
                <!-- 다른 앱 위에 뜨므로 글자가 읽히게 거의 불투명하게, 왼쪽 위에만 호박빛을 번지게 한다. -->
                <RadialGradientBrush GradientOrigin="0.08,0" Center="0.08,0" RadiusX="0.95" RadiusY="1.6">
                    <GradientStop Color="#F73B2E22" Offset="0" />
                    <GradientStop Color="#F72B2622" Offset="0.55" />
                    <GradientStop Color="#F7262220" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity=".5" ShadowDepth="6" Color="{StaticResource BlackShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="18,16,10,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <!-- 대시보드 홈의 상태 배지처럼 원형 아이콘 바탕에 결과 색을 입힌다. -->
                    <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlackSuccessSurface}"
                            BorderBrush="{StaticResource BlackSuccessRule}" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,12,0">
                        <TextBlock x:Name="IconGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource BlackSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Altong · 집중 리포트" FontSize="11" Foreground="{StaticResource BlackMuted}" />
                        <TextBlock x:Name="TitleText" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BlackText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Margin="0,4,0,0" FontSize="12" LineHeight="18" Foreground="{StaticResource BlackMuted}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="OpenButton" Content="리포트 열기" Style="{StaticResource PrimaryToastButton}" Click="OpenButton_Click" />
                            <Button x:Name="LaterButton" Content="나중에" Margin="8,0,0,0" Style="{StaticResource ToastButton}" Click="CloseButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="8"
                            VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource BlackMuted}"
                            Style="{StaticResource ToastButton}" Click="CloseButton_Click" AutomationProperties.Name="알림 닫기" />
                </Grid>
                <!-- 자동으로 닫히기까지 남은 시간. 커서를 올리면 멈춘다. -->
                <Border Grid.Row="1" Height="3" Margin="20,0,20,10" CornerRadius="1.5" Background="{StaticResource AmberTrack}" ClipToBounds="True">
                    <Border x:Name="CountdownBar" Background="{StaticResource BlackAction}" CornerRadius="1.5" RenderTransformOrigin="0,.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CountdownScale" ScaleX="1" /></Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
