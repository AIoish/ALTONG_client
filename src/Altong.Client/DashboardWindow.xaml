<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong · 집중 세션 리포트"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#050923"
        Foreground="#F2F5F8"
        WindowStyle="None"
        FontFamily="{DynamicResource DashboardFontFamily}"
        FontSize="14"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                     ResizeBorderThickness="6"
                     GlassFrameThickness="0"
                     CornerRadius="0"
                     UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Embedded BM JUA keeps the reference typography consistent on every PC. -->
        <FontFamily x:Key="DashboardFontFamily">pack://application:,,,/Altong.Client;component/Fonts/#배달의민족 주아</FontFamily>
        <FontFamily x:Key="DashboardDisplayFontFamily">pack://application:,,,/Altong.Client;component/Fonts/#배달의민족 주아</FontFamily>
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F5F8" />
        <SolidColorBrush x:Key="MutedText" Color="#CBD7EE" />
        <SolidColorBrush x:Key="Accent" Color="#A0DFD8" />
        <SolidColorBrush x:Key="AccentBlue" Color="#A5BDF0" />
        <!-- Visual reference: alistairmerritt/iOS-Tablet-Dashboard (YAML).
             WPF-native translucent layers approximate CSS backdrop blur without blurring text. -->
        <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#506F8BCD" />
            <GradientStop Color="#30233F83" Offset=".48" />
            <GradientStop Color="#40358789" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint=".8,1">
            <GradientStop Color="#85D6E6FF" />
            <GradientStop Color="#244676BD" Offset=".55" />
            <GradientStop Color="#6088B6D7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassInset" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#30395390" />
            <GradientStop Color="#35050D39" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoNavyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#456F9A" />
            <GradientStop Color="#29496F" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="30" Height="17" CornerRadius="9" Background="#394F63" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse x:Name="ToggleDot" Width="11" Height="11" Fill="#A0B4C7" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleDot" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="ToggleDot" Property="Fill" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526B80" CornerRadius="4" Margin="2" /></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="10" /></Trigger></Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Border"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Margin" Value="0,0,9,0"/></Style>
        <Style x:Key="StatusPillStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassSurface}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="9,7,16,7"/><Setter Property="Margin" Value="0,0,10,8"/></Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint=".3,1">
                        <GradientStop Color="#587693CF" />
                        <GradientStop Color="#302B438F" Offset=".55" />
                        <GradientStop Color="#35367488" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000714"
                                      BlurRadius="28"
                                      ShadowDepth="3"
                                      Direction="270"
                                      Opacity=".32" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapsuleStyle" TargetType="Border">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint=".4,1">
                        <GradientStop Color="#708CA7ED" />
                        <GradientStop Color="#40405BAC" Offset=".45" />
                        <GradientStop Color="#40233669" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000511"
                                      BlurRadius="24"
                                      ShadowDepth="3"
                                      Direction="270"
                                      Opacity=".26" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel>
                            <ContentPresenter TextElement.FontSize="16"
                                              TextElement.FontWeight="SemiBold" />
                            <Border Height="1"
                                    Margin="0,10,0,0"
                                    Background="#28D1DFFF"
                                    CornerRadius="1" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource GlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#707F9CCF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Tag" Value="CaptionControl" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="39" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF9C9C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="Foreground" Value="#C5D3EF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource GlassSurface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="0,0,0,5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="TabIndicator"
                                        Height="2"
                                        Background="{StaticResource Accent}"
                                        CornerRadius="1"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#406E8BC1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="TabSurface" Property="Background" Value="#607B9CD6" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource GlassEdge}" />
                                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#C9F4EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="1" HorizontalAlignment="Center" x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Margin="2,18,2,0" />
                            <Border Grid.Row="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <EventSetter Event="Expanded" Handler="Details_Expanded" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleSurface"
                                                Padding="12,6"
                                                CornerRadius="13"
                                                Background="{StaticResource GlassInset}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock x:Name="ExpandGlyph"
                                                           Text="›"
                                                           Foreground="#A0DFD8"
                                                           DockPanel.Dock="Right"
                                                           Margin="10,0,0,0" />
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ExpandGlyph" Property="Text" Value="⌄" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleSurface" Property="Background" Value="#506885B8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0,5" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppUsageTemplate">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding DurationText}"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Height="5"
                             Margin="0,7,0,0"
                             Maximum="100"
                             Value="{Binding Percentage}"
                             Foreground="{StaticResource AccentBlue}"
                             Background="#182C50"
                             BorderThickness="0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NotificationTemplate">
            <Border BorderBrush="#35516B" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ReceivedAtText}" />
                    <TextBlock Grid.Column="1" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{StaticResource Accent}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedText}" />
                <Grid Grid.Column="1">
                    <Border Width="1" Background="#526B80" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,5,0,0" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="7,0,0,0">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextItemTemplate">
            <TextBlock Text="{Binding}" Margin="0,4" Foreground="{StaticResource MutedText}" />
        </DataTemplate>

        <DataTemplate x:Key="HourlyTemplate">
            <StackPanel Margin="8,0">
                <StackPanel Height="85" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Rectangle Width="9" Height="{Binding BlockedHeight}" Fill="{StaticResource AccentBlue}" VerticalAlignment="Bottom" />
                    <Rectangle Width="9" Height="{Binding PassedHeight}" Fill="{StaticResource Accent}" Margin="3,0" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="{Binding TimeText}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center=".58,.32" GradientOrigin=".65,.16" RadiusX=".8" RadiusY=".95">
                <GradientStop Color="#123690" />
                <GradientStop Color="#101C61" Offset=".45" />
                <GradientStop Color="#04091F" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.CacheMode><BitmapCache /></Grid.CacheMode>
            <Grid.Effect><BlurEffect Radius="18" RenderingBias="Performance" /></Grid.Effect>
            <Viewbox Stretch="Fill">
                <Grid Width="1100" Height="720">
                    <Path Data="M-100,410 C190,45 635,14 1180,176 L1180,390 C710,254 326,630 -100,560 Z" Stroke="#404D87ED" StrokeThickness="2">
                        <Path.Fill><LinearGradientBrush StartPoint=".2,0" EndPoint=".65,1"><GradientStop Color="#50355EC1" /><GradientStop Color="#805080CF" Offset=".48" /><GradientStop Color="#07183A77" Offset="1" /></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Ellipse Width="830" Height="640" Margin="-260,130,0,0" HorizontalAlignment="Left">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#605C8AE1" /><GradientStop Color="#005C8AE1" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                    <Path Data="M580,800 C662,440 859,299 1180,243 L1180,800 Z" Stroke="#405BCCC5" StrokeThickness="1">
                        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,.7"><GradientStop Color="#003CE8B3" /><GradientStop Color="#90439F9B" Offset=".45" /><GradientStop Color="#C009333F" Offset="1" /></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Ellipse Width="610" Height="620" HorizontalAlignment="Right" Margin="0,180,-150,-150">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5533D6A5" /><GradientStop Color="#0033D6A5" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Viewbox>
        </Grid>

        <Border Background="#35050923" BorderBrush="#20C6DCFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Height="26" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#05070B" BorderBrush="#30445D" BorderThickness="1" CornerRadius="7">
                        <Viewbox Margin="6">
                            <Path Data="M12,1 L23,27 H17.2 L14.9,20.5 H9.1 L6.8,27 H1 Z M10.6,16 H13.4 L12,11.5 Z"
                                  Fill="{StaticResource LogoNavyBrush}" />
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="대시보드"
                               Foreground="#AFC1D2"
                               FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="26"
                               LineStackingStrategy="BlockLineHeight" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="MinimizeButton_Click" Content="─" ToolTip="최소화" Style="{StaticResource CaptionButtonStyle}" />
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Content="□" ToolTip="최대화 / 복원" Style="{StaticResource CaptionButtonStyle}" />
                    <Button Click="CloseButton_Click" Content="×" ToolTip="닫기" Style="{StaticResource CaptionCloseButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DashboardContent" Grid.Row="1" Margin="28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPillStyle}"><DockPanel><Border Background="#38C86A" Style="{StaticResource StatusDotStyle}"><TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="SessionStatusBadgeText" Text="기록 대기 중" FontSize="12"/><TextBlock Text="집중 세션" FontSize="10" Foreground="#B1C2E5"/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource StatusPillStyle}"><DockPanel><Border Background="#F18B46" Style="{StaticResource StatusDotStyle}"><TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="SessionStartTimeText" Text="시작 --:--" FontSize="12"/><TextBlock Text="세션 시작 시각" FontSize="10" Foreground="#B1C2E5"/></StackPanel></DockPanel></Border>
                    <Border Style="{StaticResource StatusPillStyle}"><DockPanel><Border Background="#599EFA" Style="{StaticResource StatusDotStyle}"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="SessionEndTimeText" Text="종료 --:--" FontSize="12"/><TextBlock Text="세션 종료 시각" FontSize="10" Foreground="#B1C2E5"/></StackPanel></DockPanel></Border>
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="DashboardClockText" Text="--:--" FontFamily="{StaticResource DashboardDisplayFontFamily}" FontSize="36" FontWeight="Light" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DashboardDateText" FontSize="11" Foreground="#C0CEEA" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <TabControl x:Name="DashboardTabs"
                        Grid.Row="1"
                        Style="{StaticResource DashboardTabControlStyle}"
                        ItemContainerStyle="{StaticResource DashboardTabItemStyle}"
                        SelectionChanged="DashboardTabs_SelectionChanged">
                <TabItem IsSelected="True">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" Fill="#A0DFD8" Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="개요" Margin="7,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </StackPanel>
                    </TabItem.Header>
