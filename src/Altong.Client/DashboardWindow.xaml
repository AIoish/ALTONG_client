<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="ALTONG" Width="920" Height="780" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource BlackText}" FontFamily="{x:Static services:AppTypography.BodyFont}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource BlackTextColor}" />
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource BlackMutedColor}" />
        <SolidColorBrush x:Key="WindowSurface" Color="{StaticResource BlackCanvasColor}" />
        <SolidColorBrush x:Key="CardSurface" Color="{StaticResource BlackSurfaceColor}" />
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}" /><Setter Property="BorderBrush" Value="{StaticResource BlackRule}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="{StaticResource SectionGap}" />

        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackRaised}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag.IsExpanded, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackSelection}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BlackSelectionRule}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SettingsAccordionHeader">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BlackInput}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock x:Name="SettingsIcon" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlackAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE916;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="자동 집중 관리"><Setter Property="Text" Value="&#xEB44;" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="시스템 설정"><Setter Property="Text" Value="&#xEA8F;" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="앱별 알림 제어"><Setter Property="Text" Value="&#xED35;" /></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="AppBlockedMark" Width="14" Height="14" Background="{StaticResource BlackInput}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                            <Grid>
                                <Ellipse Width="11" Height="11" Stroke="{StaticResource BlackAccentText}" StrokeThickness="1.1" />
                                <Path Data="M 3,10 L 10,3" Stroke="{StaticResource BlackAccentText}" StrokeThickness="1.1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                               Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="SettingsSummary" Grid.Column="2" Text="{Binding Path=(AutomationProperties.ItemStatus), RelativeSource={RelativeSource AncestorType=Expander}}"
                           Foreground="{StaticResource BlackAccentText}" FontSize="11" TextWrapping="NoWrap" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="앱별 알림 제어"><Setter TargetName="AppBlockedMark" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
            <Setter Property="Background" Value="{StaticResource BlackRaised}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlackAction}" />
            <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="10,18" />
        </Style>
        <Style x:Key="Shortcut" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="16,20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource CardSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackRule}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TileSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="{StaticResource BlackAction}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TileSurface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutIcon" TargetType="Border">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BlackInput}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="CaretBrush" Value="{StaticResource BlackText}" /><Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
            <Setter Property="Padding" Value="10,8" /><Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="CheckSurface" Width="20" Height="20" CornerRadius="6" Background="{StaticResource BlackSurface}"
                            BorderBrush="{StaticResource BlackControlRule}" BorderThickness="1.5" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M 4,9 L 8,13 L 15,5" Stroke="{StaticResource BlackActionText}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter x:Name="CheckContent" Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True"
                                      Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource BlackAction}" />
                        <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="HasContent" Value="False"><Setter TargetName="CheckContent" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BlackMuted}" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="23" />
            <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.ItemStatus)}" Value="선택됨">
                <Setter Property="Background" Value="{StaticResource BlackSelection}" /><Setter Property="Foreground" Value="{StaticResource BlackAccentText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackSelectionRule}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource QuietScrollViewer}" />
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BlackControlRule}" CornerRadius="3" Margin="3,0,1,0" />
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ItemsControl">
            <Style.Triggers><Trigger Property="HasItems" Value="False">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl">
                    <TextBlock Text="아직 기록이 없어요." Foreground="{StaticResource MutedText}" Margin="0,8" />
                </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="UsageRow">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                <StackPanel Grid.Column="1" Margin="4,0,16,0">
                    <TextBlock Text="{Binding AppName}" Foreground="{StaticResource PrimaryText}" />
                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{StaticResource BlackText}" Background="{StaticResource BlackRule}" BorderThickness="0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </ResourceDictionary></Window.Resources>
    <Border x:Name="DashboardSurface" Background="{StaticResource WindowSurface}" BorderBrush="{StaticResource BlackRule}" BorderThickness="1" CornerRadius="24" SizeChanged="DashboardSurface_SizeChanged">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="20,0,8,0">
                <TextBlock x:Name="DashboardBrandText" Text="Altong" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BlackSoft}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                    <Button x:Name="MaximizeButton" Content="□" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource BlackInput}" BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,22" IsHitTestVisible="False" />
                <StackPanel x:Name="NavigationRail" Margin="12,8,12,0">
                    <Button x:Name="NavHomeButton" Tag="0" Click="Navigate_Click" Content="&#xE80F;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="홈" AutomationProperties.ItemStatus="선택됨" ToolTip="홈" />
                    <Button x:Name="NavNotificationsButton" Tag="1" Click="Navigate_Click" Content="&#xEA8F;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="알림 확인" ToolTip="알림 확인" />
                    <Button x:Name="NavJournalButton" Tag="2" Click="Navigate_Click" Content="&#xE8A5;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="활동 일지" ToolTip="활동 일지" />
                    <Button x:Name="NavCalendarButton" Tag="4" Click="Navigate_Click" Content="&#xE787;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="캘린더" ToolTip="캘린더" />
                    <Button x:Name="NavSettingsButton" Tag="3" Click="Navigate_Click" Content="&#xE713;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="설정" ToolTip="설정" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,8,24,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Button x:Name="BackButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Tag="0" Click="Navigate_Click" Visibility="Collapsed" Padding="10,8" Margin="0,0,10,0" AutomationProperties.Name="홈으로 돌아가기" />
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock x:Name="DashboardClockText" HorizontalAlignment="Right" FontSize="18" />
                        <TextBlock x:Name="DashboardDateText" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="PageTitleText" Text="대시보드" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TabControl x:Name="DashboardTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="DashboardTabs_SelectionChanged">
                    <TabControl.Template><ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate></TabControl.Template>
                    <TabItem Header="홈">
                        <ScrollViewer x:Name="HomeScroll" SizeChanged="HomeScroll_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="HomeLayout" Margin="0,6,8,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="212" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel x:Name="HomeMainPanel" VerticalAlignment="Bottom">
                                    <Border x:Name="HomeFocusCard" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,20" MinHeight="360">
                                        <StackPanel>
                                        <Grid MinHeight="132">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="FocusTimerTitleText" FontSize="15" Foreground="{StaticResource BlackSoft}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="FocusDurationText" FontSize="52" FontWeight="Light" Foreground="{StaticResource BlackText}" Margin="0,6" />
                                                <TextBlock x:Name="FocusTimerCaptionText" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Border x:Name="HomeFocusStatusBadge" CornerRadius="10" Padding="10,6" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="HomeFocusStatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="HomeFocusHintText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="FocusModeToggleButton" Style="{StaticResource PrimaryButton}" MinWidth="148" Click="FocusModeToggleButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="오늘의 집중 시간" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,4" />
                                                    <TextBlock x:Name="HomeFocusUsageTotalText" Foreground="{StaticResource BlackText}" FontSize="13" Margin="0,0,0,4" />
                                                </WrapPanel>
                                                <Grid x:Name="HomeFocusUsageChart" Height="110" Margin="0,10,0,0" AutomationProperties.Name="오늘 시간대별 집중모드 사용시간">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid Height="88" VerticalAlignment="Top" Margin="0,0,4,0">
                                                        <TextBlock x:Name="HomeFocusUsageScaleText" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Top" />
                                                        <TextBlock x:Name="HomeFocusUsageMidScaleText" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="0" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                    <Grid Grid.Column="1">
                                                        <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,1,0,1" Height="88" VerticalAlignment="Top" IsHitTestVisible="False" />
                                                        <Border Background="{StaticResource BlackRaised}" Height="1" VerticalAlignment="Top" Margin="0,44,0,0" IsHitTestVisible="False" />
                                                        <ItemsControl x:Name="HomeFocusUsageItems">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                                <Grid Background="Transparent" ToolTipService.InitialShowDelay="0" Focusable="True" AutomationProperties.Name="{Binding TooltipText}">
                                                                    <Grid.ToolTip><ToolTip Background="{StaticResource BlackRaised}" Foreground="{StaticResource BlackText}" BorderBrush="{StaticResource BlackRule}" Padding="10,6" FontFamily="./Fonts/#Pretendard, Segoe UI, Malgun Gothic"><TextBlock Text="{Binding TooltipText}" /></ToolTip></Grid.ToolTip>
                                                                    <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                                                                    <Border Height="{Binding BarHeight}" VerticalAlignment="Bottom" Margin="2,0" CornerRadius="3,3,0,0">
                                                                        <Border.Style><Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource BlackMuted}" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding IsCurrentHour}" Value="True"><Setter Property="Background" Value="{StaticResource BlackAction}" /></DataTrigger></Style.Triggers>
                                                                        </Style></Border.Style>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1" Text="{Binding AxisLabel}" FontSize="10" Style="{StaticResource Muted}" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock x:Name="HomeFocusUsageStatusText" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="불러오는 중…" />
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Columns="2" Margin="-4,0,-4,0">
                                        <Button x:Name="HomeNotificationsShortcut" Tag="1" Click="Navigate_Click" Style="{StaticResource Shortcut}" MinHeight="132" Margin="4,4,4,0" AutomationProperties.Name="알림 확인" ToolTip="차단·통과 알림 확인">
                                            <StackPanel>
                                                <Border Style="{StaticResource ShortcutIcon}" Background="{StaticResource BlackSurface}" HorizontalAlignment="Left">
                                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource BlackText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="알림 확인" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="통과·차단 알림" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="HomeJournalShortcut" Tag="2" Click="Navigate_Click" Style="{StaticResource Shortcut}" MinHeight="132" Margin="4,4,4,0" AutomationProperties.Name="활동 일지" ToolTip="집중모드 중 앱 사용시간">
                                            <StackPanel>
                                                <Border Style="{StaticResource ShortcutIcon}" Background="{StaticResource BlackSurface}" HorizontalAlignment="Left">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource BlackText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="활동 일지" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="앱별 사용 기록" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                                <Grid x:Name="HomeSidePanel" Grid.Column="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid x:Name="HomeCalendarPanel" Height="284" Margin="0,0,0,12" MaxWidth="280" HorizontalAlignment="Stretch">
                                        <Button x:Name="HomeCalendarShortcut" Tag="4" Click="Navigate_Click" Style="{StaticResource Shortcut}" AutomationProperties.Name="캘린더" ToolTip="저장한 일정과 집중 리포트 조회·삭제" Margin="0,32,0,0" Padding="22" VerticalAlignment="Top" Height="238" Background="{StaticResource BlackSuccessSurface}" BorderBrush="{StaticResource BlackSuccessRule}">
                                            <StackPanel>
                                                <TextBlock x:Name="HomeCalendarIcon" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource BlackSuccess}" Margin="0,0,0,24" />
                                                <TextBlock x:Name="HomeCalendarTitle" Text="캘린더" FontSize="23" FontWeight="SemiBold" />
                                                <TextBlock Text="일정 · 집중 리포트" Foreground="{StaticResource BlackSuccessMuted}" FontSize="12" Margin="0,10,0,0" />
                                                <TextBlock Text="캘린더 열기  →" Foreground="{StaticResource BlackSuccess}" FontSize="12" Margin="0,16,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button x:Name="HomeSettingsShortcut" Grid.Row="2" Tag="3" Click="Navigate_Click" Style="{StaticResource Shortcut}" Margin="0" MinHeight="176" AutomationProperties.Name="설정" ToolTip="집중·휴식 시간 및 앱 설정">
                                        <StackPanel>
                                            <Border Style="{StaticResource ShortcutIcon}" Background="{StaticResource BlackSurface}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="HomeRoutineIconText" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource BlackSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="HomeRoutineTitleText" Text="집중 루틴" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HomeRoutineSettingsText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,14" />
                                            <TextBlock Text="설정 열기  →" Foreground="{StaticResource BlackText}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="알림 확인"><ContentControl x:Name="NotificationsHost" /></TabItem>
                    <TabItem Header="활동 일지">
                        <ScrollViewer><StackPanel>
                            <TextBlock x:Name="DataPeriodText" Text="오늘 · 집중 중 앱 사용 기록" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBlock x:Name="ActivityJournalEmptyText" Text="오늘의 집중 기록 없음" Style="{StaticResource Muted}" Margin="0,0,0,4" />

                            <Border Style="{StaticResource Card}">
                                <ItemsControl x:Name="JournalItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding SummaryText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" Margin="12,3,0,0" />
                                                <TextBlock Text="{Binding HourText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BlackText}" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Apps}"><ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="24" Height="24" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding AppName}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppName}" />
                                                        <TextBlock Text="{Binding WindowSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowSummary}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="집중 중 앱별 사용시간" Style="{StaticResource Heading}" />
                                <ItemsControl x:Name="AppUsageItemsControl" ItemTemplate="{StaticResource UsageRow}" />
                            </StackPanel></Border>
                            <TextBlock Text="현재 사용 중인 앱" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="CurrentApplicationText" Margin="0,4" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="설정">
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <Border Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=TimerSettingsExpander}">
                              <Expander x:Name="TimerSettingsExpander" Header="집중·휴식 루틴" Tag="집중·휴식 시간 설정" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <CheckBox x:Name="TimerEnabledCheckBox" Content="집중·휴식 타이머 사용" Checked="TimerOption_Changed" Unchecked="TimerOption_Changed" />
                                <TextBlock Text="타이머 없이 직접 켜고 끄기" Margin="0,10,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TimerEnabledCheckBox}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <StackPanel x:Name="TimerOptionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="집중 시간" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="분" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="FocusSessionDurationSetting" MaxLength="3" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="집중 시간, 분" /></DockPanel>
                                            <TextBlock Text="1–180분" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="휴식 시간" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="분" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="BreakDurationSetting" MaxLength="2" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="휴식 시간, 선택, 분" /></DockPanel>
                                            <TextBlock Text="0–60분 · 비우면 휴식 없음" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{StaticResource BlackSurface}" BorderBrush="{StaticResource BlackRule}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="루틴 미리보기" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                                            <TextBlock x:Name="TimerRoutinePreviewText" Foreground="{StaticResource BlackText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="타이머 종료 후에도 집중모드는 유지됩니다." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TimerSettingsFeedbackText" Text="다음 집중부터 적용" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="SaveTimerSettingsButton" Content="루틴 저장" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border x:Name="AutoDndSettingsCard" Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=AutoDndSettingsExpander}" AutomationProperties.Name="자동 집중 관리">
                              <Expander x:Name="AutoDndSettingsExpander" Header="자동 집중 관리" Tag="작업 감지 시 집중 제안 · 15분 자리비움 시 자동 종료" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <CheckBox x:Name="AutoDndEnabledCheckBox" Content="자동 집중 관리 사용" Click="AutoDndEnabledCheckBox_Click" />
                                <TextBlock x:Name="AutoDndStatusText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=SystemSettingsExpander}">
                              <Expander x:Name="SystemSettingsExpander" Header="시스템 설정" Tag="루틴 알림 · 시작 프로그램 · 앱 정보" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <TextBlock x:Name="WindowsDndStatusText" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button x:Name="ShowRoutineReminderButton" Content="현재 루틴 알림 보기" Click="ShowRoutineReminderButton_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                                <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Windows 시작 시 알통 실행" Click="LaunchAtStartupCheckBox_Click" Margin="0,4,0,0"
                                          AutomationProperties.HelpText="로그인 시 트레이에서 시작" />
                                <TextBlock x:Name="LaunchAtStartupStatusText" Text="로그인 시 트레이에서 시작" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" Margin="0,4" />
                                <Button Content="ALTONG 종료" Click="ExitApplicationButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border x:Name="NativeNotificationControlCard" Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=NotificationSettingsExpander}" AutomationProperties.Name="앱별 알림 제어">
                              <Expander x:Name="NotificationSettingsExpander" Header="앱별 알림 제어" Tag="집중 중 선택한 앱의 배너·알림음 차단" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <TextBlock x:Name="NotificationControlStatusText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="방식 변경 시 집중 종료 · 알림 설정 복구" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,8">
                                    <Button x:Name="UseAltongControlButton" Content="알통 자체 제어" Click="UseAltongControl_Click" Margin="0,0,8,8" />
                                    <Button x:Name="UseWindowsControlButton" Content="기존 Windows 방식" Click="UseWindowsControl_Click" Margin="0,0,8,8" />
                                    <Button x:Name="RefreshNotificationAppsButton" Content="앱 새로고침" Click="RefreshNotificationApps_Click" Margin="0,0,8,8" />
                                    <Button x:Name="RestoreNotificationAppsButton" Content="알림 설정 복구" Click="RestoreNotificationApps_Click" ToolTip="집중 종료 후 배너·알림음 설정 복구" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="다음 집중부터 적용 · 새 앱은 기본 선택" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel x:Name="NotificationSenderList" />
                               </StackPanel>
                              </Expander>
                            </Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="캘린더"><ContentControl x:Name="ReportCalendarHost" /></TabItem>
                </TabControl>
                <TextBlock x:Name="DataErrorText" Grid.Row="2" Foreground="{StaticResource BlackError}" FontSize="12" />
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
