<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="ALTONG" Width="920" Height="780" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#242629" Foreground="#F3F4F6" FontFamily="./Fonts/#Pretendard, Segoe UI Variable, Segoe UI, Malgun Gothic"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#F3F4F6" />
        <SolidColorBrush x:Key="MutedText" Color="#ADB2BD" />
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#272D33" Offset="0" /><GradientStop Color="#26282B" Offset=".45" /><GradientStop Color="#242629" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#303235" Offset="0" /><GradientStop Color="#2B2D30" Offset="1" />
        </LinearGradientBrush>
        <services:AppIconConverter x:Key="AppIcon" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}" /><Setter Property="BorderBrush" Value="#3D3F42" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#35383F" /><Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#484C55" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,12" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8FBDE7" /><Setter TargetName="Surface" Property="Opacity" Value=".9" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".6" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6D5FF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#99D4FA" />
            <Setter Property="Foreground" Value="#152536" />
            <Setter Property="BorderBrush" Value="#A6D5FF" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="10,18" />
        </Style>
        <Style x:Key="Shortcut" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="8,16" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TileSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileSurface" Property="Background" Value="#12FFFFFF" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="TileSurface" Property="Background" Value="#08FFFFFF" /><Setter TargetName="TileSurface" Property="Opacity" Value=".7" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="#99D4FA" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TileSurface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutIcon" TargetType="Border">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222426" /><Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="CaretBrush" Value="#A6D5FF" /><Setter Property="BorderBrush" Value="#636A78" />
            <Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="18" />
        </Style>
        <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="#69707D" CornerRadius="3" Margin="3,0,1,0" />
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ItemsControl">
            <Style.Triggers><Trigger Property="HasItems" Value="False">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl">
                    <TextBlock Text="아직 기록이 없어요." Foreground="{StaticResource MutedText}" Margin="0,20" />
                </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="UsageRow">
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                <StackPanel Grid.Column="1" Margin="8,0,24,0">
                    <TextBlock Text="{Binding AppName}" Foreground="{StaticResource PrimaryText}" />
                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" Margin="0,10,0,0" Foreground="#A6D5FF" Background="#424650" BorderThickness="0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NotificationRow">
            <Border BorderBrush="#41444C" BorderThickness="0,0,0,1" Padding="0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding AppName}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding Record.Body}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{StaticResource WindowSurface}" BorderBrush="#45474A" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
            <Grid Margin="20,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#A5DCE8" Margin="0,0,10,0" />
                    <TextBlock Text="ALTONG" FontSize="12" FontWeight="SemiBold" Foreground="#CAD7E9" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                    <Button x:Name="MaximizeButton" Content="□" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="32,12,32,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,20">
                    <Button x:Name="BackButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Tag="0" Click="Navigate_Click" Visibility="Collapsed" Margin="0,0,12,0" AutomationProperties.Name="홈으로 돌아가기" />
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock x:Name="DashboardClockText" HorizontalAlignment="Right" FontSize="18" />
                        <TextBlock x:Name="DashboardDateText" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="PageTitleText" Text="홈" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TabControl x:Name="DashboardTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="DashboardTabs_SelectionChanged">
                    <TabControl.Template><ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate></TabControl.Template>
                    <TabItem Header="홈">
                        <ScrollViewer>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Background="Transparent" BorderThickness="0" Padding="20,12,20,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="FocusTimerTitleText" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FocusDurationText" FontSize="60" FontWeight="Light" Foreground="#F5F5F5" Margin="0,2" />
                                            <TextBlock x:Name="FocusTimerCaptionText" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock x:Name="FocusModeStatusText" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                            <Button x:Name="FocusModeToggleButton" Style="{StaticResource PrimaryButton}" MinWidth="160" Click="FocusModeToggleButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="활동 기록" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ActivityStatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                            <TextBlock x:Name="ActivityErrorText" Foreground="#FFACAC" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button x:Name="ActivityToggleButton" Click="ActivityToggleButton_Click" VerticalAlignment="Center" />
                                            <Button x:Name="ActivityResultButton" Content="최근 결과 보기" Click="ShowLatestActivityResult_Click" Margin="0,8,0,0" Padding="10,8" Visibility="Collapsed" AutomationProperties.Name="최근 활동 결과 다시 보기" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="고정됨" FontSize="16" FontWeight="SemiBold" Margin="20,16,0,8" />
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Button Tag="1" Click="Navigate_Click" Style="{StaticResource Shortcut}" AutomationProperties.Name="알림 확인" ToolTip="차단·통과 알림 확인">
                                        <StackPanel>
                                            <Border Style="{StaticResource ShortcutIcon}">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#52C9F1" Offset="0" /><GradientStop Color="#1477D8" Offset="1" /></LinearGradientBrush></Border.Background>
                                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="알림 확인" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="2" Click="Navigate_Click" Style="{StaticResource Shortcut}" AutomationProperties.Name="활동 일지" ToolTip="활동 기록과 앱별 사용시간">
                                        <StackPanel>
                                            <Border Style="{StaticResource ShortcutIcon}">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BAA0F7" Offset="0" /><GradientStop Color="#7154CD" Offset="1" /></LinearGradientBrush></Border.Background>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="활동 일지" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="3" Click="Navigate_Click" Style="{StaticResource Shortcut}" AutomationProperties.Name="설정" ToolTip="집중·휴식 시간 및 앱 설정">
                                        <StackPanel>
                                            <Border Style="{StaticResource ShortcutIcon}">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A5AFBA" Offset="0" /><GradientStop Color="#515C69" Offset="1" /></LinearGradientBrush></Border.Background>
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="설정" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="알림 확인">
                        <ScrollViewer><StackPanel>
                            <TextBlock Text="차단된 알림과 통과한 알림을 확인하세요." Style="{StaticResource Muted}" Margin="0,0,0,20" />
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <DockPanel><TextBlock Text="차단한 알림" Style="{StaticResource Heading}" /><TextBlock x:Name="BlockedNotificationCountText" Margin="12,4" Foreground="#A6D5FF" /></DockPanel>
                                <ItemsControl x:Name="BlockedNotificationItemsControl" ItemTemplate="{StaticResource NotificationRow}" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <DockPanel><TextBlock Text="통과한 알림" Style="{StaticResource Heading}" /><TextBlock x:Name="PassedNotificationCountText" Margin="12,4" Foreground="#A6D5FF" /></DockPanel>
                                <ItemsControl x:Name="NotificationItemsControl" ItemTemplate="{StaticResource NotificationRow}" />
                            </StackPanel></Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="활동 일지">
                        <ScrollViewer><StackPanel>
                            <TextBlock x:Name="DataPeriodText" Text="오늘의 기록" Style="{StaticResource Muted}" Margin="0,0,0,16" />
                            <TextBlock x:Name="ActivityJournalEmptyText" Text="기록을 시작하면 집중모드 ON 구간의 앱 사용 내역이 여기에 표시됩니다." Style="{StaticResource Muted}" Margin="0,0,0,20" />
                            <TextBlock Text="앱을 사용한 흐름을 시간순으로 확인하세요." Style="{StaticResource Muted}" Margin="0,0,0,20" />
                            <Border Style="{StaticResource Card}">
                                <ItemsControl x:Name="JournalItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#41444C" BorderThickness="0,0,0,1" Padding="0,16">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Foreground="#A6D5FF" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding AppName}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="앱별 사용시간" Style="{StaticResource Heading}" />
                                <ItemsControl x:Name="AppUsageItemsControl" ItemTemplate="{StaticResource UsageRow}" />
                            </StackPanel></Border>
                            <TextBlock Text="현재 사용 중인 앱" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="CurrentApplicationText" Margin="0,8" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="설정">
                        <ScrollViewer><StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="집중과 휴식" Style="{StaticResource Heading}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="집중 시간 (분)" Margin="0,0,0,8" /><TextBox x:Name="FocusSessionDurationSetting" MaxLength="3" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="집중 시간, 분" /><TextBlock Text="1–180분" Style="{StaticResource Muted}" Margin="0,6" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="휴식 시간 (분)" Margin="0,0,0,8" /><TextBox x:Name="BreakDurationSetting" MaxLength="2" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="휴식 시간, 분" /><TextBlock Text="1–60분" Style="{StaticResource Muted}" Margin="0,6" /></StackPanel>
                                </Grid>
                                <TextBlock x:Name="FocusRoutineOverviewText" Margin="0,12" />
                                <TextBlock x:Name="FocusRoutineSettingsText" Style="{StaticResource Muted}" />
                                <TextBlock Text="집중과 휴식은 자동으로 반복되며, 휴식 중에도 Windows 방해 금지를 유지합니다." Style="{StaticResource Muted}" Margin="0,12" />
                                <TextBlock x:Name="TimerSettingsFeedbackText" Text="저장한 시간은 다음 집중 모드 시작부터 적용됩니다." Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
                                <Button Content="설정 저장" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="알림과 시스템" Style="{StaticResource Heading}" />
                                <TextBlock x:Name="WindowsDndStatusText" Style="{StaticResource Muted}" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button x:Name="ShowRoutineReminderButton" Content="현재 루틴 알림 보기" Click="ShowRoutineReminderButton_Click" Margin="0,0,12,12" />
                                    <Button Content="알림 확인" Tag="1" Click="Navigate_Click" Margin="0,0,0,12" />
                                </WrapPanel>
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" Margin="0,8" />
                                <Button Content="ALTONG 종료" Click="ExitApplicationButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel></Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
                <TextBlock x:Name="DataErrorText" Grid.Row="2" Foreground="#FFACAC" FontSize="12" />
            </Grid>
            <Border Grid.Row="2" Background="#202225" BorderBrush="#383A3D" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="28,0">
                <DockPanel>
                    <Button Content="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="20" DockPanel.Dock="Right" Click="ExitApplicationButton_Click" Style="{StaticResource Tile}" Padding="12,10" VerticalAlignment="Center" AutomationProperties.Name="ALTONG 종료" ToolTip="ALTONG 종료" />
                    <Button Tag="0" Click="Navigate_Click" Style="{StaticResource Tile}" Padding="8,6" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="User 홈으로 이동">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#E4E4E4" Margin="0,0,12,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#6B6B6B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="User" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
