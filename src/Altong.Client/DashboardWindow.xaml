<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        xmlns:local="clr-namespace:Altong.Client"
        Title="ALTONG" Width="920" Height="780" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource BlackText}" FontFamily="{x:Static services:AppTypography.BodyFont}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource BlackTextColor}" />
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource BlackMutedColor}" />
        <SolidColorBrush x:Key="WindowSurface" Color="{StaticResource BlackCanvasColor}" />
        <SolidColorBrush x:Key="CardSurface" Color="{StaticResource BlackSurfaceColor}" />
        <services:AppIconConverter x:Key="AppIcon" />
        <services:AppNameDisplayConverter x:Key="AppNameDisplay" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPane}" /><Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="{StaticResource SectionGap}" />

        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlassPaneHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource NavSelectedRule}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag.IsExpanded, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackSelection}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BlackSelectionRule}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SettingsAccordionHeader">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BlackInput}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock x:Name="SettingsIcon" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlackAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE916;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="자동 집중 관리"><Setter Property="Text" Value="&#xEB44;" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="시스템 설정"><Setter Property="Text" Value="&#xEA8F;" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="앱별 알림 제어"><Setter Property="Text" Value="&#xED35;" /></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="AppBlockedMark" Width="14" Height="14" Background="{StaticResource BlackInput}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                            <Grid>
                                <Ellipse Width="11" Height="11" Stroke="{StaticResource BlackAccentText}" StrokeThickness="1.1" />
                                <Path Data="M 3,10 L 10,3" Stroke="{StaticResource BlackAccentText}" StrokeThickness="1.1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                               Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="SettingsSummary" Grid.Column="2" Text="{Binding Path=(AutomationProperties.ItemStatus), RelativeSource={RelativeSource AncestorType=Expander}}"
                           Foreground="{StaticResource BlackAccentText}" FontSize="11" TextWrapping="NoWrap" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="앱별 알림 제어"><Setter TargetName="AppBlockedMark" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
            <Setter Property="Background" Value="{StaticResource GlassPaneHover}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavSelectedRule}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlackAction}" />
            <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="10,18" />
        </Style>
        <Style x:Key="Shortcut" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="16,20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource GlassPane}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TileSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileSurface" Property="Background" Value="{StaticResource GlassPaneHover}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="{StaticResource BlackAction}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TileSurface" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutIcon" TargetType="Border">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BlackInput}" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="CaretBrush" Value="{StaticResource BlackText}" /><Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
            <Setter Property="Padding" Value="10,8" /><Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="CheckSurface" Width="20" Height="20" CornerRadius="6" Background="{StaticResource BlackSurface}"
                            BorderBrush="{StaticResource BlackControlRule}" BorderThickness="1.5" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M 4,9 L 8,13 L 15,5" Stroke="{StaticResource BlackActionText}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter x:Name="CheckContent" Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True"
                                      Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource BlackAction}" />
                        <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="HasContent" Value="False"><Setter TargetName="CheckContent" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BlackMuted}" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource GlassPaneHover}" /><Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="QuickCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="{StaticResource BlackText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="MinHeight" Value="128" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Card" Background="{StaticResource GlassPane}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="20" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="#1FE9C995" /><Setter TargetName="Card" Property="BorderBrush" Value="#66E9C995" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value=".45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- 카드 아래 설명: 켜진 카드는 밝게(#E4DACD), 꺼진 카드는 흐리게 -->
        <Style x:Key="QuickCardText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{StaticResource BlackSoft}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="34" /><Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="RangeTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BlackMuted}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Padding" Value="12,0" /><Setter Property="Height" Value="32" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource GlassPane}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1FFFF0DC" /><Setter TargetName="Surface" Property="BorderBrush" Value="#2EFFF0DC" /><Setter Property="Foreground" Value="{StaticResource BlackText}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BlackAccentText}" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="Transparent" Padding="0,2"><ContentPresenter x:Name="Label" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource BlackFocus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RoutinePreset" TargetType="Button">
            <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
            <Setter Property="Height" Value="48" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="#0DFFF0DC" BorderBrush="#24FFF0DC" BorderThickness="1" CornerRadius="14">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Path=(AutomationProperties.ItemStatus), RelativeSource={RelativeSource Self}}" Value="선택됨">
                        <Setter TargetName="Surface" Property="Background" Value="#24E9C995" /><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackAction}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MinuteBox" TargetType="Border">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource GlassInput}" /><Setter Property="BorderBrush" Value="{StaticResource GlassInputRule}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="MinuteInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource BlackText}" /><Setter Property="CaretBrush" Value="{StaticResource BlackText}" />
            <Setter Property="FontSize" Value="13" /><Setter Property="MinWidth" Value="14" /><Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="-2,0,-1,0" />
        </Style>
        <!-- 앱 한 줄의 스위치: Tag가 true면 막음 -->
        <Style x:Key="AppSwitch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#24FFF0DC" BorderBrush="Transparent" BorderThickness="1">
                    <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Margin="2,0" HorizontalAlignment="Left" Background="{StaticResource BlackMuted}" />
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter TargetName="Track" Property="Background" Value="{StaticResource BlackAction}" />
                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Background" Value="{StaticResource BlackActionText}" />
                    </DataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BlackFocus}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value=".45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SwitchTrack" TargetType="Border">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="22" /><Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#24FFF0DC" /><Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Background" Value="{StaticResource BlackAction}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SwitchKnob" TargetType="Border">
            <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Margin" Value="3,0" />
            <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="{StaticResource BlackMuted}" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="{StaticResource BlackActionText}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource QuietScrollViewer}" />
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BlackControlRule}" CornerRadius="3" Margin="3,0,1,0" />
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                    </RepeatButton></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ItemsControl">
            <Style.Triggers><Trigger Property="HasItems" Value="False">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl">
                    <TextBlock Text="아직 기록이 없어요." Foreground="{StaticResource MutedText}" Margin="0,8" />
                </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="UsageRow">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="28" Height="28" />
                <StackPanel Grid.Column="1" Margin="4,0,16,0">
                    <TextBlock Text="{Binding AppName, Converter={StaticResource AppNameDisplay}}" ToolTip="{Binding AppName}" Foreground="{StaticResource PrimaryText}" />
                    <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{StaticResource BlackText}" Background="{StaticResource BlackRule}" BorderThickness="0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </ResourceDictionary></Window.Resources>
    <Border x:Name="DashboardSurface" Background="{StaticResource GlassBackdrop}" BorderBrush="{StaticResource GlassWindowRim}" BorderThickness="1" CornerRadius="24" SizeChanged="DashboardSurface_SizeChanged">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <local:GlassBackdrop Grid.RowSpan="2" />
            <Border Grid.RowSpan="2" Background="{StaticResource GlassWindow}" IsHitTestVisible="False" />
            <Grid Margin="20,0,8,0">
                <TextBlock x:Name="DashboardBrandText" Text="Altong" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BlackText}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" AutomationProperties.Name="최소화" />
                    <Button x:Name="MaximizeButton" Content="□" Padding="16,10" Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click" AutomationProperties.Name="최대화 또는 복원" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Padding="16,10" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="창 닫기" />
                </StackPanel>
            </Grid>
            <Grid x:Name="ShellGrid" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="NavigationRail" Margin="18,10,18,0">
                    <Button x:Name="NavHomeButton" Tag="0" Click="Navigate_Click" Content="&#xE80F;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="홈" AutomationProperties.ItemStatus="선택됨" ToolTip="메인 화면" />
                    <Button x:Name="NavNotificationsButton" Tag="1" Click="Navigate_Click" Content="&#xEA8F;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="알림 확인" ToolTip="알림 확인" />
                    <Button x:Name="NavJournalButton" Tag="2" Click="Navigate_Click" Content="&#xE8A5;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="활동 일지" ToolTip="활동 일지" />
                    <Button x:Name="NavInsightsButton" Tag="5" Click="Navigate_Click" Content="&#xE9D2;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="집중 인사이트" ToolTip="집중 인사이트" />
                    <Button x:Name="NavCalendarButton" Tag="4" Click="Navigate_Click" Content="&#xE787;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="캘린더" ToolTip="캘린더" />
                    <Button x:Name="NavSettingsButton" Tag="3" Click="Navigate_Click" Content="&#xE713;" Style="{StaticResource NavigationButton}" AutomationProperties.Name="설정" ToolTip="설정" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="8,6,28,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <!-- 탭마다 오른쪽이 다르다: 홈·알림=시계, 활동 일지=‹ 오늘 ›, 캘린더=범례, 설정=버전. ⋯는 도안에 없는 기능 모음 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="DashboardClockText" FontSize="22" FontWeight="Light" VerticalAlignment="Bottom" />
                        <!-- 활동 일지: 오늘 · 이번 주 · 이번 달 -->
                        <Border x:Name="JournalRangeTabs" Padding="3" CornerRadius="13" Background="#0DFFF0DC" BorderBrush="#1AFFF0DC" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="JournalTodayTab" GroupName="JournalRange" Tag="0" Content="오늘" IsChecked="True" Checked="JournalRange_Checked" Style="{StaticResource RangeTab}" />
                                <RadioButton x:Name="JournalWeekTab" GroupName="JournalRange" Tag="1" Content="이번 주" Checked="JournalRange_Checked" Style="{StaticResource RangeTab}" Margin="2,0" />
                                <RadioButton x:Name="JournalMonthTab" GroupName="JournalRange" Tag="2" Content="이번 달" Checked="JournalRange_Checked" Style="{StaticResource RangeTab}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SettingsVersionText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="PageMenuButton" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource HeaderButton}" Margin="10,0,0,0" Padding="0"
                                Click="PageMenu_Click" Visibility="Collapsed" AutomationProperties.Name="더 보기" ToolTip="더 보기" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="DashboardDateText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageTitleText" Text="메인 화면" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <TabControl x:Name="DashboardTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="DashboardTabs_SelectionChanged">
                    <TabControl.Template><ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"
                                          services:MotionBehavior.TransitionKey="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" />
                    </ControlTemplate></TabControl.Template>
                    <TabItem Header="홈">
                        <ScrollViewer x:Name="HomeScroll" SizeChanged="HomeScroll_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="HomeLayout" Margin="0,0,8,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel x:Name="HomeMainPanel">
                                    <Border x:Name="HomeFocusCard" Style="{StaticResource Card}" Padding="24,22" Margin="0" MinHeight="290">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top">
                                                <Border x:Name="HomeFocusStatusBadge" DockPanel.Dock="Right" CornerRadius="13" Padding="12,5" BorderThickness="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="HomeFocusStatusDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="HomeFocusHintText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="FocusTimerTitleText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Button x:Name="FocusModeToggleButton" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" MinWidth="148" Height="46" HorizontalAlignment="Left" Click="FocusModeToggleButton_Click" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,14,0,16">
                                                <TextBlock x:Name="FocusDurationText" FontSize="76" FontWeight="Light" Foreground="{StaticResource BlackText}" TextWrapping="NoWrap" />
                                                <TextBlock x:Name="FocusTimerCaptionText" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                                                <Border x:Name="HomeFocusProgressTrack" Height="6" CornerRadius="3" Background="{StaticResource AmberTrack}" Margin="0,16,0,0" Visibility="Collapsed" ClipToBounds="True">
                                                    <Border x:Name="HomeFocusProgressBar" CornerRadius="3" Background="{StaticResource BlackAction}" RenderTransformOrigin="0,.5">
                                                        <Border.RenderTransform><ScaleTransform x:Name="HomeFocusProgressScale" ScaleX="0" /></Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="HomeFlowCard" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="오늘의 집중 시간" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeFocusUsageTotalText" FontSize="32" FontWeight="Light" Margin="0,6,0,0" TextWrapping="NoWrap" />
                                        <Grid x:Name="HomeFocusUsageChart" Margin="0,14,0,0" AutomationProperties.Name="오늘 시간대별 집중모드 사용시간">
                                            <ItemsControl x:Name="HomeFocusUsageItems">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Background="Transparent" ToolTipService.InitialShowDelay="0" Focusable="True" AutomationProperties.Name="{Binding TooltipText}">
                                                        <Grid.ToolTip><ToolTip Background="{StaticResource BlackRaised}" Foreground="{StaticResource BlackText}" BorderBrush="{StaticResource BlackRule}" Padding="10,6" FontFamily="./Fonts/#Pretendard, Segoe UI, Malgun Gothic"><TextBlock Text="{Binding TooltipText}" /></ToolTip></Grid.ToolTip>
                                                        <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                                                        <Border Margin="1,0" Height="88" CornerRadius="3" Background="{StaticResource AmberTrack}" VerticalAlignment="Bottom" />
                                                        <Border Height="{Binding BarHeight}" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="3" Background="{StaticResource BlackAction}">
                                                            <Border.Style><Style TargetType="Border">
                                                                <Setter Property="Opacity" Value=".55" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsCurrentHour}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers>
                                                            </Style></Border.Style>
                                                        </Border>
                                                        <Canvas Grid.Row="1" ClipToBounds="False"><TextBlock Canvas.Top="4" Text="{Binding AxisLabel}" FontSize="10" Style="{StaticResource Muted}" TextWrapping="NoWrap" /></Canvas>
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock x:Name="HomeFocusUsageStatusText" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="불러오는 중…" />
                                    </StackPanel>
                                </Border>
                                <Grid x:Name="HomeSidePanel" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="HomeNotificationsShortcut" Tag="1" Click="Navigate_Click" Style="{StaticResource Shortcut}" Margin="0" Padding="20,18" MinHeight="132" VerticalContentAlignment="Top" AutomationProperties.Name="알림 확인" ToolTip="통과·차단 알림 확인">
                                        <StackPanel>
                                            <Border Style="{StaticResource TileIcon}"><TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource BlackAction}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="알림 확인" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                                            <TextBlock x:Name="HomeNotificationSummaryText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="통과·차단 알림" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HomeJournalShortcut" Grid.Column="2" Tag="2" Click="Navigate_Click" Style="{StaticResource Shortcut}" Margin="0" Padding="18,18" MinHeight="132" VerticalContentAlignment="Top" AutomationProperties.Name="활동 일지" ToolTip="집중모드 중 앱 사용시간">
                                        <StackPanel>
                                            <Border Style="{StaticResource TileIcon}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource BlackAction}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="활동 일지" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                                            <TextBlock Text="앱별 기록" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HomeCalendarShortcut" Grid.Column="4" Tag="4" Click="Navigate_Click" Style="{StaticResource Shortcut}" Margin="0" Padding="20,18" MinHeight="132" VerticalContentAlignment="Top"
                                            Background="#1FB9D6C2" AutomationProperties.Name="캘린더" ToolTip="저장한 일정과 집중 리포트 조회">
                                        <StackPanel>
                                            <Border Style="{StaticResource TileIcon}"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource BlackSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="캘린더" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                                            <TextBlock x:Name="HomeNextScheduleWhen" Foreground="{StaticResource BlackSuccessMuted}" FontSize="12" Margin="0,4,0,0" Text="일정 · 집중 리포트" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="알림 확인"><ContentControl x:Name="NotificationsHost" /></TabItem>
                    <TabItem Header="활동 일지">
                        <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="JournalScroll_SizeChanged"><Grid Margin="0,0,8,0">
                            <!-- 도안 "앱 순위 + 시간대 열지도": 왼쪽 2/5 가장 오래 쓴 앱, 오른쪽 3/5 언제 무엇을 썼나 -->
                            <Grid x:Name="JournalOverview" MinHeight="{Binding ViewportHeight, ElementName=JournalScroll}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="RankingPane" Style="{StaticResource Card}" Margin="0" Padding="20,18" AutomationProperties.Name="앱 순위">
                                    <StackPanel>
                                        <TextBlock Text="가장 오래 쓴 앱" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <StackPanel x:Name="JournalRankingList" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HeatmapPane" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20,18" AutomationProperties.Name="시간대별 사용 시간">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <TextBlock DockPanel.Dock="Right" Text="막대가 높을수록 오래" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                            <TextBlock Text="언제 무엇을 썼나" FontSize="15" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <Border x:Name="JournalInsight" DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="14,12" CornerRadius="14" Background="#14E9C995" BorderBrush="#38E9C995" BorderThickness="1" Visibility="Collapsed">
                                            <TextBlock FontSize="13" LineHeight="21" Foreground="{StaticResource BlackSoft}">
                                                <Run x:Name="JournalInsightLead" Text="가장 오래 집중한 때는 " /><Run x:Name="JournalInsightHour" FontWeight="Bold" Foreground="{StaticResource BlackText}" /><Run x:Name="JournalInsightTail" />
                                            </TextBlock>
                                        </Border>
                                        <!-- 시각별 쌓인 막대: 한 시간에 쓴 시간이 막대 높이, 색은 앱(위 순위와 같은 색) -->
                                        <WrapPanel x:Name="JournalLegend" DockPanel.Dock="Top" Margin="0,10,0,0" />
                                        <Grid Margin="0,12,0,0">
                                            <Canvas x:Name="JournalHourChart" MinHeight="200" ClipToBounds="False" SizeChanged="JournalHourChart_SizeChanged" AutomationProperties.Name="시간대별 앱 사용 시간" />
                                            <TextBlock x:Name="JournalEmptyText" Text="집중하면 언제 어떤 앱을 썼는지 여기에 쌓여요" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed" />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <!-- ⋯ 메뉴 [시간대별 기록 보기]: 도안 화면 대신 시간대별 앱 기록 -->
                            <StackPanel x:Name="JournalDetails" Visibility="Collapsed">
                                <Button x:Name="JournalBackButton" Content="‹ 앱 순위로" Style="{StaticResource LinkButton}" Click="JournalBack_Click" HorizontalAlignment="Left" Margin="2,0,0,12" />
                                <TextBlock Text="시간대별 기록" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,6" />
                                <TextBlock x:Name="DataPeriodText" Text="오늘 · 집중 중 앱 사용 기록" Style="{StaticResource Muted}" Margin="2,0,0,4" />
                                <TextBlock x:Name="ActivityJournalEmptyText" Text="오늘의 집중 기록 없음" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <Border Style="{StaticResource Card}">
                                    <ItemsControl x:Name="JournalItemsControl"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding SummaryText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" Margin="12,3,0,0" />
                                                    <TextBlock Text="{Binding HourText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BlackText}" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Apps}"><ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Image Source="{Binding AppName, Converter={StaticResource AppIcon}}" Width="24" Height="24" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding AppName, Converter={StaticResource AppNameDisplay}}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppName}" />
                                                            <TextBlock Text="{Binding WindowSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowSummary}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Border>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="집중 중 앱별 사용시간" Style="{StaticResource Heading}" />
                                    <ItemsControl x:Name="AppUsageItemsControl" ItemTemplate="{StaticResource UsageRow}" />
                                </StackPanel></Border>
                                <TextBlock Text="현재 사용 중인 앱" Style="{StaticResource Muted}" />
                                <TextBlock x:Name="CurrentApplicationText" Margin="0,4" />
                            </StackPanel>
                        </Grid></ScrollViewer>
                    </TabItem>
                    <TabItem Header="설정">
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SettingsScroll_SizeChanged"><StackPanel>
                            <!-- 도안 "빠른 토글 + 세부": 위 네 카드는 바로 켜고 끄고, 아래 두 칸은 자주 바꾸는 값. 나머지는 ⋯ 메뉴 [세부 설정] -->
                            <StackPanel x:Name="SettingsQuickPanel">
                            <UniformGrid x:Name="QuickSettingsGrid" Columns="4" Margin="0,0,-12,2">
                                <Button x:Name="QuickTimerCard" Style="{StaticResource QuickCard}" Click="QuickTimerCard_Click" Tag="{Binding IsChecked, ElementName=TimerEnabledCheckBox}"
                                        AutomationProperties.Name="집중·휴식 타이머 켜고 끄기">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top"><Border Style="{StaticResource SwitchTrack}" DockPanel.Dock="Right" Margin="8,0,0,0"><Border Style="{StaticResource SwitchKnob}" /></Border><TextBlock Text="타이머" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel>
                                        <TextBlock x:Name="QuickTimerText" Style="{StaticResource QuickCardText}" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="QuickAutoDndCard" Style="{StaticResource QuickCard}" Click="QuickAutoDndCard_Click" Tag="{Binding IsChecked, ElementName=AutoDndEnabledCheckBox}"
                                        IsEnabled="{Binding IsEnabled, ElementName=AutoDndEnabledCheckBox}" AutomationProperties.Name="자동 집중 관리 켜고 끄기">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top"><Border Style="{StaticResource SwitchTrack}" DockPanel.Dock="Right" Margin="8,0,0,0"><Border Style="{StaticResource SwitchKnob}" /></Border><TextBlock Text="자동 집중" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel>
                                        <TextBlock Text="작업을 감지하면 집중을 제안해요" Style="{StaticResource QuickCardText}" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="QuickStartupCard" Style="{StaticResource QuickCard}" Click="QuickStartupCard_Click" Tag="{Binding IsChecked, ElementName=LaunchAtStartupCheckBox}"
                                        IsEnabled="{Binding IsEnabled, ElementName=LaunchAtStartupCheckBox}" AutomationProperties.Name="Windows 시작 시 실행 켜고 끄기">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top"><Border Style="{StaticResource SwitchTrack}" DockPanel.Dock="Right" Margin="8,0,0,0"><Border Style="{StaticResource SwitchKnob}" /></Border><TextBlock Text="시작 시 실행" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel>
                                        <TextBlock x:Name="QuickStartupText" Text="Windows가 켜질 때 트레이에서 대기" Style="{StaticResource QuickCardText}" />
                                    </DockPanel>
                                </Button>
                                <Border x:Name="QuickDndCard" Background="{StaticResource GlassPane}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="20" Padding="16" MinHeight="128" Margin="0,0,12,12">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top"><TextBlock x:Name="QuickDndStateText" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlackSuccess}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBlock Text="방해 금지" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel>
                                        <TextBlock Text="Windows 방해 금지와 함께 켜고 꺼요" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,12,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, ElementName=WindowsDndStatusText}" />
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                            <Grid x:Name="SettingsPanes">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="RoutinePane" Style="{StaticResource Card}" Margin="0" Padding="20,18">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="집중 루틴" FontSize="15" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource GlassDivider}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="자리비움 자동 종료" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AwayAutoEndText" Text="15분 동안 입력이 없으면 집중을 끝내요" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 타이머가 꺼져 있으면 루틴을 고를 일이 없으니 안내만 보인다 -->
                                        <TextBlock x:Name="RoutineTimerOffText" DockPanel.Dock="Top" Text="타이머를 켜면 집중·휴식 시간을 고를 수 있어요" Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0" Visibility="Collapsed" />
                                        <StackPanel x:Name="RoutineOptions" VerticalAlignment="Top">
                                            <UniformGrid x:Name="RoutinePresetGrid" Columns="3" Margin="0,12,-8,0">
                                                <Button Content="25 · 5" Tag="25,5" Click="RoutinePreset_Click" Style="{StaticResource RoutinePreset}" AutomationProperties.Name="집중 25분, 휴식 5분" />
                                                <Button Content="50 · 10" Tag="50,10" Click="RoutinePreset_Click" Style="{StaticResource RoutinePreset}" AutomationProperties.Name="집중 50분, 휴식 10분" />
                                                <Button Content="90 · 15" Tag="90,15" Click="RoutinePreset_Click" Style="{StaticResource RoutinePreset}" AutomationProperties.Name="집중 90분, 휴식 15분" />
                                            </UniformGrid>
                                            <WrapPanel Margin="0,12,0,0">
                                                <TextBlock Text="직접 입력" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Border Style="{StaticResource MinuteBox}"><StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="RoutineFocusInput" Style="{StaticResource MinuteInput}" MaxLength="3" LostKeyboardFocus="RoutineInput_LostFocus" KeyDown="RoutineInput_KeyDown" AutomationProperties.Name="집중 시간, 분" />
                                                    <TextBlock Text="분" VerticalAlignment="Center" FontSize="13" />
                                                </StackPanel></Border>
                                                <TextBlock Text="집중" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="10,0" />
                                                <Border Style="{StaticResource MinuteBox}"><StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="RoutineBreakInput" Style="{StaticResource MinuteInput}" MaxLength="2" LostKeyboardFocus="RoutineInput_LostFocus" KeyDown="RoutineInput_KeyDown" AutomationProperties.Name="휴식 시간, 분" />
                                                    <TextBlock Text="분" VerticalAlignment="Center" FontSize="13" />
                                                </StackPanel></Border>
                                                <TextBlock Text="휴식" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </WrapPanel>
                                            <TextBlock x:Name="RoutineFeedbackText" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" services:MotionBehavior.TextFeedback="True">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="BlockedAppsPane" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20,18" AutomationProperties.Name="앱별 알림 제어">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <TextBlock x:Name="BlockedAppsCountText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                            <TextBlock Text="집중 중 막을 앱" FontSize="15" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <Button x:Name="ShowAllAppsButton" DockPanel.Dock="Bottom" Content="앱 목록 전체 보기" Click="ShowAllApps_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,0" Height="36" FontSize="13" />
                                        <StackPanel x:Name="QuickAppList" Margin="0,8,0,0" VerticalAlignment="Top" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                            </StackPanel>
                            <StackPanel x:Name="SettingsDetailPanel" Visibility="Collapsed">
                            <Button x:Name="SettingsBackButton" Content="‹ 빠른 설정으로" Style="{StaticResource LinkButton}" Click="SettingsBack_Click" HorizontalAlignment="Left" Margin="2,0,0,12" />
                            <Border Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=TimerSettingsExpander}">
                              <Expander x:Name="TimerSettingsExpander" Header="집중·휴식 루틴" Tag="집중·휴식 시간 설정" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <CheckBox x:Name="TimerEnabledCheckBox" Content="집중·휴식 타이머 사용" Checked="TimerOption_Changed" Unchecked="TimerOption_Changed" />
                                <TextBlock Text="타이머 없이 직접 켜고 끄기" Margin="0,10,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TimerEnabledCheckBox}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <StackPanel x:Name="TimerOptionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="자주 쓰는 루틴" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="3" Margin="0,0,-8,14">
                                        <Button Content="25 · 5" Tag="25,5" Click="TimerPreset_Click" Style="{StaticResource PresetButton}" AutomationProperties.Name="집중 25분, 휴식 5분" />
                                        <Button Content="50 · 10" Tag="50,10" Click="TimerPreset_Click" Style="{StaticResource PresetButton}" AutomationProperties.Name="집중 50분, 휴식 10분" />
                                        <Button Content="90 · 15" Tag="90,15" Click="TimerPreset_Click" Style="{StaticResource PresetButton}" AutomationProperties.Name="집중 90분, 휴식 15분" />
                                    </UniformGrid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="집중 시간" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="분" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="FocusSessionDurationSetting" MaxLength="3" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="집중 시간, 분" /></DockPanel>
                                            <TextBlock Text="1–180분" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="휴식 시간" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="분" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="BreakDurationSetting" MaxLength="2" TextChanged="TimerSetting_TextChanged" AutomationProperties.Name="휴식 시간, 선택, 분" /></DockPanel>
                                            <TextBlock Text="0–60분 · 비우면 휴식 없음" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{StaticResource BlackSurface}" BorderBrush="{StaticResource BlackRule}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="루틴 미리보기" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                                            <TextBlock x:Name="TimerRoutinePreviewText" Foreground="{StaticResource BlackText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="타이머 종료 후에도 집중모드는 유지됩니다." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TimerSettingsFeedbackText" Text="다음 집중부터 적용" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" services:MotionBehavior.TextFeedback="True" />
                                <Button x:Name="SaveTimerSettingsButton" Content="루틴 저장" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border x:Name="AutoDndSettingsCard" Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=AutoDndSettingsExpander}" AutomationProperties.Name="자동 집중 관리">
                              <Expander x:Name="AutoDndSettingsExpander" Header="자동 집중 관리" Tag="작업 감지 시 집중 제안 · 15분 자리비움 시 자동 종료" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <CheckBox x:Name="AutoDndEnabledCheckBox" Content="자동 집중 관리 사용" Click="AutoDndEnabledCheckBox_Click" />
                                <TextBlock x:Name="AutoDndStatusText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=SystemSettingsExpander}">
                              <Expander x:Name="SystemSettingsExpander" Header="시스템 설정" Tag="루틴 알림 · 시작 프로그램 · 앱 정보" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <TextBlock x:Name="WindowsDndStatusText" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button x:Name="ShowRoutineReminderButton" Content="현재 루틴 알림 보기" Click="ShowRoutineReminderButton_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                                <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Windows 시작 시 알통 실행" Click="LaunchAtStartupCheckBox_Click" Margin="0,4,0,0"
                                          AutomationProperties.HelpText="로그인 시 트레이에서 시작" />
                                <TextBlock x:Name="LaunchAtStartupStatusText" Text="로그인 시 트레이에서 시작" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite" services:MotionBehavior.TextFeedback="True" />
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" Margin="0,4" />
                                <Button Content="ALTONG 종료" Click="ExitApplicationButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            <Border x:Name="NativeNotificationControlCard" Style="{StaticResource SettingsCard}" Tag="{Binding ElementName=NotificationSettingsExpander}" AutomationProperties.Name="앱별 알림 제어">
                              <Expander x:Name="NotificationSettingsExpander" Header="앱별 알림 제어" Tag="집중 중 선택한 앱의 배너·알림음 차단" Style="{StaticResource BlackExpander}" HeaderTemplate="{StaticResource SettingsAccordionHeader}">
                               <StackPanel Margin="40,0,0,10">
                                <Border BorderBrush="{StaticResource BlackRule}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />
                                <TextBlock x:Name="NotificationControlStatusText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="ReenableAltongControlHint" Text="다시 사용하면 집중 종료 · 알림 설정 복구" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                                <WrapPanel Margin="0,8,0,8">
                                    <Button x:Name="UseAltongControlButton" Content="알통 자체 제어 다시 사용" Click="UseAltongControl_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                                    <Button x:Name="RefreshNotificationAppsButton" Content="앱 새로고침" Click="RefreshNotificationApps_Click" Margin="0,0,8,8" />
                                    <Button x:Name="RestoreNotificationAppsButton" Content="알림 설정 복구" Click="RestoreNotificationApps_Click" ToolTip="집중 종료 후 배너·알림음 설정 복구" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="다음 집중부터 적용 · 새 앱은 기본 선택" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel x:Name="NotificationSenderList" />
                               </StackPanel>
                              </Expander>
                            </Border>
                            </StackPanel>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="캘린더"><ContentControl x:Name="ReportCalendarHost" /></TabItem>
                    <TabItem Header="인사이트"><ContentControl x:Name="InsightsHost" /></TabItem>
                </TabControl>
                <TextBlock x:Name="DataErrorText" Grid.Row="2" Foreground="{StaticResource BlackError}" FontSize="12" />
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
