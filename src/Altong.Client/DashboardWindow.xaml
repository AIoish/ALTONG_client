<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="Altong · 집중 세션 리포트"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        Foreground="#172033"
        WindowStyle="None"
        FontFamily="{DynamicResource DashboardFontFamily}"
        FontSize="14"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                     ResizeBorderThickness="6"
                     GlassFrameThickness="0"
                     CornerRadius="0"
                     UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <services:AppIconConverter x:Key="NotificationAppIcon" />
        <!-- Embedded BM JUA keeps the reference typography consistent on every PC. -->
        <FontFamily x:Key="DashboardFontFamily">pack://application:,,,/Altong.Client;component/Fonts/#배달의민족 주아</FontFamily>
        <FontFamily x:Key="DashboardDisplayFontFamily">pack://application:,,,/Altong.Client;component/Fonts/#배달의민족 주아</FontFamily>
        <SolidColorBrush x:Key="PrimaryText" Color="#172033" />
        <SolidColorBrush x:Key="MutedText" Color="#68758A" />
        <SolidColorBrush x:Key="Accent" Color="#168C82" />
        <SolidColorBrush x:Key="AccentBlue" Color="#5876C7" />
        <!-- Visual reference: alistairmerritt/iOS-Tablet-Dashboard (YAML).
             WPF-native translucent layers approximate CSS backdrop blur without blurring text. -->
        <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8FFFFFF" />
            <GradientStop Color="#C8F8FAFD" Offset=".52" />
            <GradientStop Color="#BCECF3FA" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint=".8,1">
            <GradientStop Color="#FFFFFFFF" />
            <GradientStop Color="#A8D8E1ED" Offset=".55" />
            <GradientStop Color="#C5C9D7E8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassInset" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BDEAF0F6" />
            <GradientStop Color="#99F7F9FC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoNavyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#456F9A" />
            <GradientStop Color="#29496F" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="30" Height="17" CornerRadius="9" Background="#D5DEE8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse x:Name="ToggleDot" Width="11" Height="11" Fill="#8D9AAD" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleDot" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="ToggleDot" Property="Fill" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#A7B5C8" CornerRadius="4" Margin="2" /></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="10" /></Trigger></Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Border"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Margin" Value="0,0,9,0"/></Style>
        <Style x:Key="StatusPillStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassSurface}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="9,7,16,7"/><Setter Property="Margin" Value="0,0,10,8"/></Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint=".35,1">
                        <GradientStop Color="#EEFFFFFF" />
                        <GradientStop Color="#DDF9FBFD" Offset=".55" />
                        <GradientStop Color="#CDEBF2F8" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#71829A"
                                      BlurRadius="26"
                                      ShadowDepth="5"
                                      Direction="270"
                                      Opacity=".16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapsuleStyle" TargetType="Border">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint=".4,1">
                        <GradientStop Color="#F2FFFFFF" />
                        <GradientStop Color="#DDF4F8FC" Offset=".45" />
                        <GradientStop Color="#CDE7EFF7" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#71829A"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity=".13" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel>
                            <ContentPresenter TextElement.FontSize="16"
                                              TextElement.FontWeight="SemiBold" />
                            <Border Height="1"
                                    Margin="0,10,0,0"
                                    Background="#3090A4BD"
                                    CornerRadius="1" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="Surface_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Surface_MouseLeave" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource GlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#F2FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="#6F93C8" />
                                <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Tag" Value="CaptionControl" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="39" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#D94A5A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource DashboardFontFamily}" />
            <Setter Property="Foreground" Value="#6B778B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource GlassSurface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="0,0,0,5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="TabIndicator"
                                        Height="2"
                                        Background="{StaticResource Accent}"
                                        CornerRadius="1"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#DFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#172033" />
                                <Setter TargetName="TabSurface" Property="Background" Value="#F5FFFFFF" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource GlassEdge}" />
                                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#6F93C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="2,18,2,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                    <Button x:Name="SessionResultButton" Click="OpenSessionResult_Click" ToolTip="완료된 집중 결과 보기"
                                            AutomationProperties.Name="집중 결과 보기" Margin="8,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Results.Latest, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▥" FontFamily="Segoe UI Symbol" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,7,0" />
                                            <TextBlock Text="결과" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Results.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Row="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <EventSetter Event="Expanded" Handler="Details_Expanded" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleSurface"
                                                Padding="12,6"
                                                CornerRadius="13"
                                                Background="{StaticResource GlassInset}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock x:Name="ExpandGlyph"
                                                           Text="›"
                                                           Foreground="{StaticResource Accent}"
                                                           DockPanel.Dock="Right"
                                                           Margin="10,0,0,0" />
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ExpandGlyph" Property="Text" Value="⌄" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleSurface" Property="Background" Value="#DDF3F7FB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0,5" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppUsageTemplate">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding DurationText}"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Height="5"
                             Margin="0,7,0,0"
                             Maximum="100"
                             Value="{Binding Percentage}"
                             Foreground="{StaticResource AccentBlue}"
                             Background="#DCE5EF"
                             BorderThickness="0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NotificationTemplate">
            <Border BorderBrush="#D9E1EA" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ReceivedAtText}" />
                    <TextBlock Grid.Column="1" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{StaticResource Accent}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlockedNotificationTemplate">
            <Border BorderBrush="#D9E1EA" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="58"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FDE8EB" VerticalAlignment="Center">
                        <TextBlock Text="×" Foreground="#B63943" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding ReceivedAtText}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PassedNotificationTemplate">
            <Border BorderBrush="#D9E1EA" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="58"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="#E1F4EF" VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#168C82" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding ReceivedAtText}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedText}" />
                <Grid Grid.Column="1">
                    <Border Width="1" Background="#CCD6E2" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,5,0,0" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="7,0,0,0">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextItemTemplate">
            <TextBlock Text="{Binding}" Margin="0,4" Foreground="{StaticResource MutedText}" />
        </DataTemplate>

        <DataTemplate x:Key="HourlyTemplate">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                <Image Grid.Column="1" Source="{Binding AppName, Converter={StaticResource NotificationAppIcon}}" Width="26" Height="26"
                       HorizontalAlignment="Left" ToolTip="{Binding AppName}" AutomationProperties.Name="{Binding AppName}" />
                <TextBlock Grid.Column="2" Text="{Binding AppName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Title}" />
                <Border Grid.Column="3" Background="{StaticResource GlassInset}" CornerRadius="7" Padding="5,4">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" TextAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FCFDFE" />
                <GradientStop Color="#F3F7FB" Offset=".48" />
                <GradientStop Color="#EDF3F8" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.CacheMode><BitmapCache /></Grid.CacheMode>
            <Grid.Effect><BlurEffect Radius="34" RenderingBias="Performance" /></Grid.Effect>
            <Viewbox Stretch="Fill">
                <Grid Width="1100" Height="720">
                    <Path Data="M-100,410 C190,45 635,14 1180,176 L1180,390 C710,254 326,630 -100,560 Z" Stroke="#306D8FD0" StrokeThickness="1">
                        <Path.Fill><LinearGradientBrush StartPoint=".2,0" EndPoint=".65,1"><GradientStop Color="#4079A9E8" /><GradientStop Color="#469CCDE3" Offset=".48" /><GradientStop Color="#08FFFFFF" Offset="1" /></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Ellipse Width="830" Height="640" Margin="-260,130,0,0" HorizontalAlignment="Left">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#3E9FB9E5" /><GradientStop Color="#009FB9E5" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                    <Path Data="M580,800 C662,440 859,299 1180,243 L1180,800 Z" Stroke="#286EC7B7" StrokeThickness="1">
                        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,.7"><GradientStop Color="#00FFFFFF" /><GradientStop Color="#3F8ED6C7" Offset=".45" /><GradientStop Color="#18C9E5DC" Offset="1" /></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Ellipse Width="610" Height="620" HorizontalAlignment="Right" Margin="0,180,-150,-150">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#358AD7C4" /><GradientStop Color="#008AD7C4" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Viewbox>
        </Grid>

        <Border Background="#B8FFFFFF" BorderBrush="#A8DCE4ED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Height="26" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#F8FAFC" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="7">
                        <Viewbox Margin="6">
