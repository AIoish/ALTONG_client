<Window x:Class="Altong.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong · 집중 세션 리포트"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117"
        Foreground="#F2F5F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#171C25" />
        <SolidColorBrush x:Key="PanelBorder" Color="#293241" />
        <SolidColorBrush x:Key="MutedText" Color="#9AA6B2" />
        <SolidColorBrush x:Key="Accent" Color="#65D6B4" />
        <SolidColorBrush x:Key="AccentBlue" Color="#88A8FF" />
        <SolidColorBrush x:Key="Warning" Color="#F5B971" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202733" />
            <Setter Property="Foreground" Value="#DCE5ED" />
            <Setter Property="BorderBrush" Value="#354151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock FontSize="13"
                           Foreground="{StaticResource Accent}"
                           Text="ALTONG  /  SESSION REVIEW" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Text="집중 세션 리포트" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedText}"
                           Text="화면 프로토타입 · 실제 DB 및 AI 요약 데이터 연결 예정" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Border Margin="0,0,10,0"
                        Padding="12,7"
                        Background="#17352F"
                        CornerRadius="12">
                    <TextBlock Foreground="{StaticResource Accent}"
                               Text="● 세션 리포트" />
                </Border>
                <Button Content="닫기"
                        Click="CloseButton_Click"
                        Style="{StaticResource GhostButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="총 집중 시간" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="--:--" />
                    <TextBlock Foreground="{StaticResource Accent}" Text="세션 데이터 연결 예정" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="8,0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="차단된 알림" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="--건" />
                    <TextBlock Foreground="{StaticResource Warning}" Text="DB 연결 예정" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="8,0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="통과된 알림" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="--건" />
                    <TextBlock Foreground="{StaticResource AccentBlue}" Text="AI 결과 연결 예정" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="절약된 전환 위험 시간" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="--분" />
                    <TextBlock Foreground="{StaticResource Accent}" Text="산정 규칙 연결 예정" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="부재 중 수신된 알림" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedText}"
                                   Text="업무, 일정, 일상 그룹별 알림 카드가 표시될 영역입니다." />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="24"
                            Background="#11161E"
                            BorderBrush="#293241"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="34"
                                       Text="🛡" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="표시할 알림 데이터가 없습니다." />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedText}"
                                       Text="팀원 1의 저장 계층과 팀원 2의 필터 결과를 연결하면 카드가 표시됩니다."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Margin="0,0,0,10" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="방해 타임라인" />
                        <TextBlock Margin="0,6,0,16"
                                   Foreground="{StaticResource MutedText}"
                                   Text="세션 중 발생한 이벤트 흐름" />
                        <Border Padding="14"
                                Background="#202733"
                                CornerRadius="10">
                            <TextBlock Foreground="{StaticResource MutedText}"
                                       Text="타임라인 데이터 연결 예정"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="오늘의 업무 일지" />
                        <TextBlock Margin="0,6,0,12"
                                   Foreground="{StaticResource MutedText}"
                                   Text="활성 창 기록과 알림 요약을 결합한 TIL 영역입니다." />
                        <Border Padding="12"
                                Background="#202733"
                                CornerRadius="10">
                            <TextBlock Foreground="#D0D7DE"
                                       Text="팀원 3의 요약 결과 연결 예정"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Content="마크다운 복사"
                                    IsEnabled="False"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Content="파일 저장"
                                    IsEnabled="False"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,18,0,0"
                   Foreground="#697586"
                   Text="Altong Dashboard Prototype · 공통 데이터 계약 연결 전 화면 뼈대" />
    </Grid>
</Window>
