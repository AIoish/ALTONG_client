<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
<Border Style="{StaticResource PanelStyle}">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                                <StackPanel>
                                    <ContentControl Content="집중 환경" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="설정 기능 연결 예정" Foreground="{StaticResource Accent}" Margin="0,0,0,14" />
                                    <TextBlock Text="집중 세션 기본 시간" />
                                    <TextBox x:Name="FocusSessionDurationSetting"
                                             Text="집중 시간 설정 연결 예정"
                                             IsReadOnly="True"
                                             Margin="0,7,0,14"
                                             Padding="12,8"
                                             Background="{StaticResource GlassInset}"
                                             Foreground="{StaticResource MutedText}"
                                             BorderBrush="#4A647C"
                                             BorderThickness="1" />
                                    <CheckBox x:Name="TrayTooltipEnabledSetting"
                                              Content="트레이 hover 정보 표시"
                                              IsEnabled="False"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="DashboardAutoOpenEnabledSetting"
                                              Content="집중 세션 종료 후 대시보드 자동 표시"
                                              IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
</Border>
<Border Style="{StaticResource PanelStyle}">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                                <StackPanel>
                                    <ContentControl Content="알림 및 시스템" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="알림 분류 기준" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="NotificationFilterGuideText"
                                               Text="긴급도와 현재 작업 맥락을 바탕으로 알림을 분류합니다."
                                               Foreground="{StaticResource MutedText}"
                                               Margin="0,6,0,16" />
                                    <TextBlock Text="Windows 방해 금지 상태" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="WindowsDndStatusText"
                                               Text="Windows 방해 금지 상태 연결 예정"
                                               Foreground="{StaticResource MutedText}"
                                               Margin="0,6,0,16" />
                                    <TextBlock x:Name="AppVersionText" Text="ALTONG · 버전 확인 중" Foreground="{StaticResource MutedText}" />
                                </StackPanel>
                            </ScrollViewer>
</Border>
<Border Style="{StaticResource PanelStyle}">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="설정 저장" FontWeight="SemiBold" />
                                        <TextBlock Text="실제 환경설정 서비스가 연결되면 변경 사항을 저장할 수 있어요."
                                                   Foreground="{StaticResource MutedText}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="SaveSettingsButton"
                                            DockPanel.Dock="Right"
                                            Content="설정 저장"
                                            IsEnabled="False"
                                            Style="{StaticResource ActionButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </ScrollViewer>
</Border>
</Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border x:Name="DashboardLoadingState" Grid.Row="1" Background="#EE06132C" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="리포트를 불러오는 중입니다." Margin="0,14" />
                </StackPanel>
            </Border>
            <Border x:Name="DashboardErrorState" Grid.Row="1" Background="#EE06132C" Visibility="Collapsed">
                <TextBlock x:Name="DashboardErrorMessageText"
                           Text="리포트를 불러오지 못했습니다."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
