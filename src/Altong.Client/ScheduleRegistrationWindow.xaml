<Window x:Class="Altong.Client.ScheduleRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Altong.Client.Services"
        Title="일정 등록" Width="440" SizeToContent="Height" MaxHeight="600"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="{x:Static services:AppTypography.BodyFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Altong.Client;component/Themes/BlackTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style TargetType="Expander" BasedOn="{StaticResource BlackExpander}" />
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource BlackMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="CaretBrush" Value="{StaticResource BlackText}" />
                <Setter Property="Background" Value="{StaticResource GlassInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="{StaticResource BlackInput}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
            </Style>
            <Style TargetType="DatePickerTextBox">
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{StaticResource BlackInput}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="TimeSlotItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackSelection}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BlackSelection}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TimeSlotComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackControlRule}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TimeSlotItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Surface" Background="{StaticResource BlackInput}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource BlackMuted}" StrokeThickness="1.2"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=선택}"
                                           Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                    <Border Background="{StaticResource BlackRaised}" BorderBrush="{StaticResource BlackControlRule}" BorderThickness="1"
                                            CornerRadius="8" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DialogButton" TargetType="Button">
                <Setter Property="services:MotionBehavior.ButtonFeedback" Value="True" />
                <Setter Property="FontFamily" Value="{x:Static services:AppTypography.BodyFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Background" Value="{StaticResource BlackRaised}" />
                <Setter Property="Foreground" Value="{StaticResource BlackText}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassPaneRule}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BlackFocus}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value=".4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DialogButton}" />
            <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Background" Value="{StaticResource BlackAction}" />
                <Setter Property="Foreground" Value="{StaticResource BlackActionText}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlackAction}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource GlassFloating}" BorderBrush="{StaticResource GlassWindowRim}"
            BorderThickness="1" CornerRadius="16" Margin="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource GlassDivider}"
                    BorderThickness="0,0,0,1" Padding="18,14,12,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource BlackSuccess}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="일정 등록" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BlackText}" />
                        <TextBlock Text="{Binding AppDisplayName, StringFormat={}{0}에서 추출한 일정}"
                                   FontSize="11.5" Foreground="{StaticResource BlackMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource BlackMuted}" Background="Transparent" BorderThickness="0"
                            Padding="10,6" Click="Cancel_Click" AutomationProperties.Name="닫기" />
                </Grid>
            </Border>

            <!-- Scrollable Form Body -->
            <ScrollViewer Grid.Row="1" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="18,14,18,6">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="일정 제목" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TitleTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="일정 제목" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="시작 날짜" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate}" AutomationProperties.Name="시작 날짜" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="시작 시각" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding StartTimeOptions}" SelectedItem="{Binding StartTime}"
                                      Style="{StaticResource TimeSlotComboBox}" AutomationProperties.Name="시작 시각" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="종료 날짜" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EndDate}" AutomationProperties.Name="종료 날짜" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="종료 시각" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding EndTimeOptions}" SelectedItem="{Binding EndTime}"
                                      Style="{StaticResource TimeSlotComboBox}" AutomationProperties.Name="종료 시각" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="장소 · 선택" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="일정 장소" />

                    <TextBlock Text="약속 세부사항 · 선택" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="96"
                             AutomationProperties.Name="약속 세부사항" />

                    <Expander Header="{Binding TimeZoneHeader}" FontSize="12" Foreground="{StaticResource BlackMuted}" Margin="0,0,0,6">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="다른 시간대 일정만 바꾸세요 · 예: America/New_York" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                     AutomationProperties.Name="일정 시간대" />
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="DialogStatusText" Text="{Binding Status}" Foreground="{StaticResource BlackError}"
                               FontSize="12" Margin="0,4,0,6"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GlassDivider}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsCancel="True"
                            Margin="0,0,8,0" MinWidth="72" />
                    <Button x:Name="ConfirmSaveButton" Content="최종 등록" Click="ConfirmSave_Click" IsDefault="True"
                            IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryDialogButton}" MinWidth="96" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
