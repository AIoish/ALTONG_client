<Window x:Class="Altong.Client.NotificationDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong 집중 모드"
        Width="740" Height="190"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None"
        UseLayoutRounding="True">
    <!--
        상단 노치 하나만 그리는 창. 노치와 알림 패널을 한 창, 한 윤곽 도형(NotchBody)으로 그려
        패널이 노치에서 아래로 늘어나는 동안 두 부분이 어긋나지 않는다. 바탕(Canvas)은 투명이라
        도형 밖의 클릭은 아래 앱으로 전달된다. 위치·크기는 코드에서 노치 가운데를 기준으로 정한다.
    -->
    <Canvas x:Name="Root">
        <!-- 노치(+열려 있으면 패널) 실루엣. 모양은 코드에서 열림 정도에 따라 다시 만든다. -->
        <Path x:Name="NotchBody" Fill="#000000" Cursor="Hand"
              MouseLeftButtonDown="Notch_MouseLeftButtonDown"
              MouseMove="Notch_MouseMove" MouseLeftButtonUp="Notch_MouseLeftButtonUp"
              LostMouseCapture="Notch_LostMouseCapture"
              MouseEnter="Pointer_Changed" MouseLeave="Pointer_Changed"
              AutomationProperties.Name="Altong 상단 노치"
              AutomationProperties.HelpText="커서를 올려 알림 패널 펼치기, 클릭하여 대시보드 열기, 좌우로 드래그하여 이동">
            <Path.RenderTransform><ScaleTransform x:Name="TopNotchClickScale" /></Path.RenderTransform>
        </Path>
        <!--
            닫힌 노치 영역의 표시등과 켜짐 효과(일렁임). 노치 모양으로 잘라 그린다.
            일렁임: 청록·라벤더 색 물결이 노치 안을 천천히 한 번 흐른다. 양 끝은 투명, 가운데는 불투명도 약 44%.
        -->
        <Grid x:Name="NotchFace" Width="360.2" Height="30" IsHitTestVisible="False">
            <Grid.Clip>
                <PathGeometry Figures="M0,0 C3.4,0 25.7,5.3 31.4,14.5 C34.2,19 47.2,30 62.4,30 L297.8,30 C313,30 326,19 328.8,14.5 C334.5,5.3 356.8,0 360.2,0 Z" />
            </Grid.Clip>
            <Rectangle x:Name="TopNotchRipple" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="TopNotchRippleMove" X="-1" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#0072B5A6" Offset="0" />
                        <GradientStop Color="#7072B5A6" Offset=".3" />
                        <GradientStop Color="#70A99BE0" Offset=".5" />
                        <GradientStop Color="#7072B5A6" Offset=".7" />
                        <GradientStop Color="#0072B5A6" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="TopNotchQuietDot" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill><SolidColorBrush x:Name="TopNotchStatusBrush" Color="#72B5A6" /></Ellipse.Fill>
            </Ellipse>
            <StackPanel x:Name="TopNotchUrgentIndicator" Orientation="Horizontal" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding ElementName=TopNotchQuietDot, Path=Fill}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TopNotchUrgentCountText" FontSize="11" FontWeight="SemiBold" Foreground="#EEAA92"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!-- 알림 패널 내용(NotificationPanel)은 코드에서 이 자리에 넣는다. -->
        <ContentControl x:Name="PanelHost" Visibility="Collapsed" Focusable="False" />
        <!--
            호버·패널이 열린 동안 보이는 은색 윤곽선. 화면 끝에 닿는 위쪽 변은 긋지 않는다.
            노치·패널 실루엣으로 잘라 두께 2 중 안쪽 1만 보인다. 빛 번짐은 쓰지 않는다.
        -->
        <Path x:Name="TopNotchOutline" Opacity="0" IsHitTestVisible="False" Stroke="#C4C8D0" StrokeThickness="2" />
        <Grid x:Name="ReminderBubble" Visibility="Collapsed" Width="344" Height="122">
            <Button x:Name="ReminderDismissButton" Click="CloseReminder_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="닫기: 집중 안내"
                    AutomationProperties.HelpText="말풍선 어디를 클릭해도 안내만 닫힙니다. 집중 세션은 유지됩니다.">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
            <Border x:Name="ReminderCard" Margin="0,9,0,0" Padding="18,10" CornerRadius="18"
                    BorderBrush="#CFE4E0" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F7FFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ReminderDismissButton}" Value="True">
                                <Setter Property="Background" Value="#FFF0F4F3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPressed, ElementName=ReminderDismissButton}" Value="True">
                                <Setter Property="Background" Value="#FFE6EEEC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" Direction="270" Opacity=".24" ShadowDepth="4" Color="#40536A" />
                </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReminderTitleText" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#172033" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                       Text="어디든 눌러 닫기" FontSize="10"
                                       Foreground="#68758A" TextAlignment="Right"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock x:Name="ReminderStatusText" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#168C82" />
                        <TextBlock x:Name="ReminderMessageText" Margin="0,7,0,0" FontSize="11" Foreground="#68758A"
                                   TextWrapping="Wrap" MaxHeight="34" />
                    </StackPanel>
            </Border>
            </Button>
            <Polygon x:Name="ReminderArrow" Points="0,10 18,10 9,0" Fill="{Binding Background, ElementName=ReminderCard}" Stroke="#CFE4E0" StrokeThickness="1"
                     Cursor="Hand" MouseLeftButtonUp="CloseReminder_Click"
                     HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Grid>

    </Canvas>
</Window>
