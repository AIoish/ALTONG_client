<Window x:Class="Altong.Client.NotificationDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong 집중 모드"
        Width="360" Height="136"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ReminderBubble" Grid.Column="0" Visibility="Collapsed" Margin="8,12,2,12">
            <Border Margin="0,0,10,0" Padding="18,14" CornerRadius="18"
                    Background="#F7FFFFFF" BorderBrush="#CFE4E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" Direction="270" Opacity=".24" ShadowDepth="4" Color="#40536A" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ReminderTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock x:Name="ReminderStatusText" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#168C82" />
                        <TextBlock x:Name="ReminderMessageText" Margin="0,5,0,0" FontSize="11" Foreground="#68758A"
                                   TextWrapping="Wrap" MaxHeight="34" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Click="CloseReminder_Click" Width="26" Height="26"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,-5,-5,0"
                            Padding="0" FontSize="17" Cursor="Hand" Background="Transparent"
                            BorderThickness="0" Foreground="#68758A" ToolTip="알림 닫기" />
                </Grid>
            </Border>
            <Polygon Points="0,0 12,9 0,18" Fill="#F7FFFFFF" Stroke="#CFE4E0" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="DockSurface" Grid.Column="1" Margin="8" Background="Transparent" Cursor="Hand"
              RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="DockSurface_MouseLeftButtonDown"
              MouseMove="DockSurface_MouseMove"
              MouseLeftButtonUp="DockSurface_MouseLeftButtonUp"
              LostMouseCapture="DockSurface_LostMouseCapture"
              ToolTip="집중 모드 진행 중&#x0a;클릭하여 대시보드 열기/닫기&#x0a;위아래로 드래그하여 위치 이동">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ClickScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Background="#FF000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.35" ShadowDepth="4" Color="#000000" />
                </Border.Effect>
            </Border>

            <Rectangle x:Name="ActivationHalo" Margin="1" Fill="Transparent" IsHitTestVisible="False"
                       Opacity="0" RadiusX="19" RadiusY="19" Stroke="#72B5A6" StrokeThickness="1.5">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.6" ShadowDepth="0" Color="#72B5A6" />
                </Rectangle.Effect>
            </Rectangle>

            <Rectangle x:Name="ActivationGlow" Margin="1" Fill="Transparent" IsHitTestVisible="False"
                       Opacity="0" RadiusX="19" RadiusY="19" Stroke="#B7D9D0"
                       StrokeDashArray="24 174" StrokeThickness="2.25">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="11" Opacity="0.7" ShadowDepth="0" Color="#72B5A6" />
                </Rectangle.Effect>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Ellipse Grid.Row="0" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#72B5A6">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.35" ShadowDepth="0" Color="#72B5A6" />
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,3" Fill="#B8BBC4" />
                    <Ellipse Width="6" Height="6" Margin="0,3" Fill="#B8BBC4" />
                    <Ellipse Width="6" Height="6" Margin="0,3" Fill="#B8BBC4" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
