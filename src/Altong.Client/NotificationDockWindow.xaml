<Window x:Class="Altong.Client.NotificationDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altong 집중 모드"
        Width="56"
        Height="136"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="DockSurface"
            Margin="8"
            Background="#F0222428"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="20"
            Cursor="Hand"
            MouseLeftButtonUp="DockSurface_MouseLeftButtonUp"
            ToolTip="집중 모드 진행 중&#x0a;클릭하여 Altong 열기">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              Opacity="0.35"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Ellipse Grid.Row="0"
                     Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#65D6B4">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      Opacity="0.65"
                                      ShadowDepth="0"
                                      Color="#65D6B4" />
                </Ellipse.Effect>
            </Ellipse>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="6"
                         Height="6"
                         Margin="0,3"
                         Fill="#B8BBC4" />
                <Ellipse Width="6"
                         Height="6"
                         Margin="0,3"
                         Fill="#B8BBC4" />
                <Ellipse Width="6"
                         Height="6"
                         Margin="0,3"
                         Fill="#B8BBC4" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
